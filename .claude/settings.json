{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-template.sh",
            "timeout": 10,
            "statusMessage": "Validating template..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-data-files.sh",
            "timeout": 5,
            "statusMessage": "Checking data file constraints..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-quality@chezmoi-personal": true
  },
  "basicMemory": {
    "primaryProject": "chezmoi",
    "sessionProfile": "coding",
    "repository": "cearley/dotfiles",
    "placementConventions": "Session checkpoints and notes live under sessions/, reference material under reference/, and project status notes under status/."
  }
}
