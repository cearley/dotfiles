{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-template.sh",
            "timeout": 10,
            "statusMessage": "Validating template..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-data-files.sh",
            "timeout": 5,
            "statusMessage": "Checking data file constraints..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "hookify@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  }
}
