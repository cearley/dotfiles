{{- if and (eq .chezmoi.os "darwin") (has "ai" .tags) -}}
#!/bin/bash

# run_onchange trigger - packages.yaml changes or every 7 days: {{ includeTemplate "time-bucket" (dict "days" 7) }}

set -euo pipefail

source "{{ .chezmoi.sourceDir -}}/scripts/shared-utils.sh"

if ! require_tools claude; then
    exit 1
fi

# Source shell secrets so env vars (e.g. LOCALSTACK_AUTH_TOKEN) are available
# for MCP server registration. chezmoi applies files before running after-scripts,
# so ~/.zsh_secrets is already written on disk by the time this script executes.
if [[ -f "$HOME/.zsh_secrets" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.zsh_secrets"
fi

{{- $settings := includeTemplate "machine-settings" . | fromJson }}
{{- $claudeEnvs := default (list "~/.claude") (index $settings "claude_envs") }}
{{- $claudeCode := index $.packages.darwin.ai.agents "claude_code" }}
{{- $mcpServers := default (list) $claudeCode.mcp_servers }}

{{- if not $mcpServers }}
print_message "skip" "No MCP servers declared in ai.agents.claude_code.mcp_servers — nothing to do"
exit 0
{{- end }}

_register_mcp_for_env() {
    local env_dir="$1"
    print_message "info" "Registering MCP servers for $(basename "$env_dir")..."

{{- range $mcpServers }}
{{- $name := .name }}
{{- $scope := "user" }}{{- if hasKey . "scope" }}{{- $scope = .scope }}{{- end }}
{{- $cmd := .command }}
{{- $envMap := dict }}
{{- if hasKey . "env" }}{{- $envMap = .env }}{{- end }}
    # Register: {{ $name }}
    _skip_server=false
    _env_flags=""
{{- range $var, $val := $envMap }}
{{- if eq $val "" }}
    if [[ -z "${{"{"}}{{ $var }}:-{{"}"}}" ]]; then
        print_message "warning" "Skipping MCP server '{{ $name }}': env var '{{ $var }}' is unset"
        _skip_server=true
    else
        _env_flags+=" -e {{ $var }}=${{"{"}}{{ $var }}{{"}"}}"
    fi
{{- else }}
    _env_flags+=" -e {{ $var }}={{ $val }}"
{{- end }}
{{- end }}
    if [[ "$_skip_server" == false ]]; then
        # shellcheck disable=SC2086
        _mcp_exit=0
        _mcp_output=$(CLAUDE_CONFIG_DIR="$env_dir" claude mcp add --scope {{ $scope }} "{{ $name }}"${_env_flags} -- {{ $cmd }} 2>&1) || _mcp_exit=$?
        if [[ $_mcp_exit -eq 0 ]]; then
            print_message "success" "Registered MCP server: {{ $name }}"
        elif echo "$_mcp_output" | grep -q "already exists"; then
            CLAUDE_CONFIG_DIR="$env_dir" claude mcp remove "{{ $name }}" --scope {{ $scope }} 2>/dev/null || true
            # shellcheck disable=SC2086
            _mcp_exit=0
            _mcp_output=$(CLAUDE_CONFIG_DIR="$env_dir" claude mcp add --scope {{ $scope }} "{{ $name }}"${_env_flags} -- {{ $cmd }} 2>&1) || _mcp_exit=$?
            if [[ $_mcp_exit -eq 0 ]]; then
                print_message "success" "Updated MCP server: {{ $name }}"
            else
                echo "$_mcp_output"
                print_message "warning" "Could not update MCP server '{{ $name }}' in $(basename "$env_dir") — skipping"
            fi
        else
            echo "$_mcp_output"
            print_message "warning" "Could not register MCP server '{{ $name }}' in $(basename "$env_dir") — skipping"
        fi
    fi
{{- end }}

    print_message "success" "MCP server setup complete for $(basename "$env_dir")"
}

for_each_claude_env _register_mcp_for_env{{ range $claudeEnvs }} "{{ . }}"{{ end }}

{{ end -}}
