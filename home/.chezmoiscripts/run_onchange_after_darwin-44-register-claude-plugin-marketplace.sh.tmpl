{{- if and (eq .chezmoi.os "darwin") (has "ai" .tags) -}}
#!/bin/bash

# run_onchange trigger - every 7 days: {{ includeTemplate "time-bucket" (dict "days" 7) }}

set -euo pipefail

source "{{ .chezmoi.sourceDir -}}/scripts/shared-utils.sh"

if package_layer_should_skip "claude"; then
    print_message "skip" "Skipping Claude Code plugin marketplace registration for this run"
    exit 0
fi

if ! require_tools claude; then
    exit 1
fi

{{- $settings := includeTemplate "machine-settings" . | fromJson }}
{{- $claudeEnvs := default (list "~/.claude") (index $settings "claude_envs") }}

# This repo's own local plugin marketplace (.claude-plugin/marketplace.json at the repo
# root) — self-referential, so it can't be declared in the static
# home/.chezmoidata/packages.yaml plugin_marketplaces list like remote marketplaces are.
# Registers the marketplace only; enabling any specific plugin from it stays a deliberate
# per-project step (see openspec/specs/setup-memory-workflow), never done here.
#
# .chezmoi.sourceDir resolves to the *chezmoiroot-relative* source dir (this repo's
# home/, per .chezmoiroot), not the repo root — the marketplace files live one level up,
# outside home/, so they're never chezmoi-templated or applied. Repo root is that dir's
# parent.
MARKETPLACE_PATH="$(dirname "{{ .chezmoi.sourceDir }}")"

_register_marketplace_for_env() {
    local env_dir="$1"
    print_message "info" "Registering local plugin marketplace for $(basename "$env_dir")..."

    if ! CLAUDE_CONFIG_DIR="$env_dir" claude plugins marketplace add "$MARKETPLACE_PATH" --scope user 2>&1; then
        print_message "warning" "Could not register local marketplace in $(basename "$env_dir") — skipping"
        return
    fi

    print_message "success" "Local plugin marketplace registered for $(basename "$env_dir")"
}

for_each_claude_env _register_marketplace_for_env{{ range $claudeEnvs }} "{{ . }}"{{ end }}

{{ end -}}
