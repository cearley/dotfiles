{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# retry trigger - last failure: {{ includeTemplate "failure-stamp" (merge (dict "name" "brew-28") .) }}

set -euo pipefail

source "{{ .chezmoi.sourceDir -}}/scripts/shared-utils.sh"

if ! require_tools brew scutil; then
    exit 1
fi

# This script installs additional packages using Homebrew based on the specific computer name.
#
# Maintenance: Update brewfiles by periodically running:
# brew bundle dump --file=$HOME/Brewfile --force
{{ $settings := includeTemplate "machine-settings" . | fromJson }}
{{- $brewfile := index $settings "brewfile" -}}
{{- if $brewfile -}}
  {{- $brewfilePath := printf "%s/brewfiles/%s" .chezmoi.sourceDir $brewfile -}}
  {{- if stat $brewfilePath -}}
brewfile={{ $brewfilePath }}
# brewfile hash: {{ include $brewfilePath | sha256sum }}
  {{- else -}}
brewfile=""
  {{- end -}}
{{- else -}}
brewfile=""
{{- end }}
{{- $computerName := includeTemplate "machine-name" . }}

if [[ ! -f $brewfile ]]; then
    print_message "skip" "Skipping additional package installation - brewfile not found for this machine ({{- $computerName -}})"
    print_message "tip" "You can create a brewfile at '{{ .chezmoi.sourceDir }}/brewfiles/your-brewfile' and update '{{ .chezmoi.sourceDir }}/.chezmoidata/config.yaml' to point to it."
    exit 0
fi

if brew bundle check --file=$brewfile >/dev/null 2>&1; then
    print_message "skip" "Skipping additional package installation - all packages already installed and up to date"
    exit 0
fi

print_message "info" "Installing additional packages using Homebrew..."

_icloud_available=true
warn_icloud_not_signed_in || { _icloud_available=false; export HOMEBREW_BUNDLE_MAS_SKIP=1; }

export HOMEBREW_ACCEPT_EULA=Y
any_failed=0
if ! brew update; then
    any_failed=1
    print_message "warning" "brew update failed — continuing with the current Homebrew metadata."
fi

# Missing machine-specific packages (App Store apps, VS Code extensions, etc.) install only after confirmation.
if ! missing=$(brew bundle check --no-upgrade --verbose --file=$brewfile 2>&1); then
    echo "$missing"
    if [ -t 0 ]; then
        read -p "🍺 Install missing packages from your brewfile? (y/N): " -n 1 -r
        echo
    else
        print_message "skip" "Non-interactive session (no TTY) — defaulting to skip missing package installation"
        REPLY="N"
    fi
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_message "skip" "Skipping missing package installation"
    elif ! brew bundle install --no-upgrade -v --file=$brewfile; then
        any_failed=1
        print_message "warning" "brew bundle completed with errors — some packages may not be installed."
    fi
fi

# The full check reports missing and outdated items alike, so only offer
# upgrades when nothing is missing (declined or failed installs stay missing).
if ! brew bundle check --no-upgrade --file=$brewfile >/dev/null 2>&1; then
    print_message "skip" "Skipping update check — some brewfile packages are still missing"
elif ! brew bundle check --file=$brewfile >/dev/null 2>&1; then
    if [ -t 0 ]; then
        read -p "🍺 Packages from your brewfile have updates available — install them now? (y/N): " -n 1 -r
        echo
    else
        print_message "skip" "Non-interactive session (no TTY) — defaulting to skip package updates"
        REPLY="N"
    fi
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_message "skip" "Skipping package updates"
    elif ! brew bundle install --upgrade -v --file=$brewfile; then
        any_failed=1
        print_message "warning" "brew bundle (upgrade) completed with errors — some packages may not be updated."
    fi
fi

if [[ "$_icloud_available" == false ]]; then
    print_message "info" "Sign in to iCloud in System Settings, then run 'chezmoi apply' again to install App Store apps"
fi

# Record the failure and exit 0 so the rest of `chezmoi apply` (file updates,
# after scripts) still runs; the failure stamp re-triggers this script next time.
if [ "$any_failed" -eq 1 ]; then
    record_script_failure "brew-28"
fi

{{ end -}}