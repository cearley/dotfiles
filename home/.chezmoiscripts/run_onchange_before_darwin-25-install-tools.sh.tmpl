{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# run_onchange trigger - packages.yaml changes or every 7 days:  {{ includeTemplate "time-bucket" (dict "days" 7) }}

set -euo pipefail

source "{{ .chezmoi.sourceDir -}}/scripts/shared-utils.sh"

if ! require_tools uv; then
    exit 1
fi

print_message "info" "Installing tools using uv..."
# Upgrade all existing tools first (allow partial failure — some tools may require
# custom install flags and are handled by the install loop below)
uv tool update --all || print_message "warning" "uv tool update --all had errors — continuing with installs"
{{- $groups := includeTemplate "package-layer-items" (merge (dict "key" "uv") .) | fromJson }}
{{- range $groups }}
# Install {{ .category }} tools
{{ range .items -}}
uv tool install {{ . }}
{{ end -}}
{{- end }}

{{ end -}}
