{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# run_onchange trigger - packages.yaml changes or every 7 days:  {{ includeTemplate "time-bucket" (dict "days" 7) }}
# retry trigger - last failure: {{ includeTemplate "failure-stamp" (merge (dict "name" "brew-23") .) }}

set -euo pipefail

source "{{ .chezmoi.sourceDir -}}/scripts/shared-utils.sh"

if ! require_tools brew; then
    exit 1
fi

any_failed=0

print_message "info" "Installing packages using Homebrew..."

{{ $icloudAccountId := includeTemplate "icloud-account-id" . | trim -}}
{{ $icloudSignedIn := ne $icloudAccountId "" -}}
warn_icloud_not_signed_in || true

{{ $tapGroups := includeTemplate "package-layer-items" (merge (dict "key" "taps") .) | fromJson -}}
{{- $brewGroups := includeTemplate "package-layer-items" (merge (dict "key" "brews") .) | fromJson -}}
{{- $caskGroups := includeTemplate "package-layer-items" (merge (dict "key" "casks") .) | fromJson -}}
{{- $masGroups := includeTemplate "package-layer-items" (merge (dict "key" "mas") .) | fromJson -}}
{{- $envGroups := includeTemplate "package-layer-items" (merge (dict "key" "brew_env") .) | fromJson -}}

# Pre-tap all required sources before brew bundle runs.
# brew bundle's fetch/validation phase checks casks before tap declarations
# in the Brewfile are processed, which fails on fresh machines where the
# tap is not yet registered.
print_message "info" "Adding Homebrew taps..."
{{- range .packages.darwin.taps }}
{{ if has . $.packages.darwin.trusted }}brew trust {{ . | quote }} && {{ end -}}
brew tap {{ . | quote }}
{{- end }}
{{- range $tapGroups }}
  {{- range .items }}
{{ if has . $.packages.darwin.trusted }}brew trust {{ . | quote }} && {{ end -}}
brew tap {{ . | quote }}
{{- end }}
{{- end }}

export HOMEBREW_NO_AUTO_UPDATE=1
brew update

{{- $allEnv := dict }}
{{- range $envGroups }}
  {{- range $k, $v := .items }}
    {{- $allEnv = set $allEnv $k $v }}
  {{- end }}
{{- end }}
{{- if $allEnv }}
# Export environment variables required for package installation
  {{- range $k, $v := $allEnv }}
export {{ $k }}={{ $v | quote }}
  {{- end }}
{{- end }}

{{- $tapByCategory := dict }}
{{- range $tapGroups }}
  {{- $tapByCategory = set $tapByCategory .category .items }}
{{- end }}
{{- $brewByCategory := dict }}
{{- range $brewGroups }}
  {{- $brewByCategory = set $brewByCategory .category .items }}
{{- end }}
{{- $caskByCategory := dict }}
{{- range $caskGroups }}
  {{- $caskByCategory = set $caskByCategory .category .items }}
{{- end }}
{{- $masByCategory := dict }}
{{- range $masGroups }}
  {{- $masByCategory = set $masByCategory .category .items }}
{{- end }}
{{- $hasCasks := false }}
{{- $hasMas := false }}
{{- range $category := prepend .tag_choices "core" }}
  {{- $caskItems := index $caskByCategory $category }}
  {{- $masItems := index $masByCategory $category }}
  {{- if $caskItems }}
    {{- $hasCasks = true }}
  {{- end }}
  {{- if and $icloudSignedIn $masItems }}
    {{- $hasMas = true }}
  {{- end }}
{{- end }}

# Taps and formulae install unconditionally — only what's missing, no confirmation needed.
brew_exit=0
brew bundle install --no-upgrade -v --file=/dev/stdin <<'BUNDLE_EOF' || brew_exit=$?
{{- range .packages.darwin.taps }}
tap {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{- end }}

{{- range $category := prepend .tag_choices "core" }}
  {{- $tapItems := index $tapByCategory $category }}
  {{- $brewItems := index $brewByCategory $category }}
  {{- if or $tapItems $brewItems }}

# Install {{ $category }} packages
    {{- if $tapItems }}
{{ range $tapItems -}}
tap {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if $brewItems }}
{{ range $brewItems -}}
brew {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}
  {{- end }}
{{- end }}
BUNDLE_EOF

if [ "$brew_exit" -ne 0 ]; then
    any_failed=1
    print_message "warning" "brew bundle completed with errors — some packages may not be installed."
    print_message "info" "Run 'chezmoi apply' again after resolving the issue (e.g., restore network, fix broken cask entry)."
fi

{{ if not $hasCasks -}}
print_message "skip" "No cask packages to install for this tag set"
{{ else -}}
cask_exit=0
brew bundle install --no-upgrade -v --file=/dev/stdin <<'CASK_EOF' || cask_exit=$?
{{- range $category := prepend .tag_choices "core" }}
  {{- $caskItems := index $caskByCategory $category }}
  {{- if $caskItems }}

# Install {{ $category }} cask packages
{{ range $caskItems -}}
cask {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
  {{- end }}
{{- end }}
CASK_EOF

if [ "$cask_exit" -ne 0 ]; then
    any_failed=1
    print_message "warning" "brew bundle (casks) completed with errors — some packages may not be installed."
    print_message "info" "Run 'chezmoi apply' again after resolving the issue (e.g., restore network, fix broken cask entry)."
fi
{{ end }}

{{ if not $hasMas -}}
print_message "skip" "No Mac App Store packages to install for this tag set"
{{ else -}}
mas_exit=0
brew bundle install --no-upgrade -v --file=/dev/stdin <<'MAS_EOF' || mas_exit=$?
{{- range $category := prepend .tag_choices "core" }}
  {{- $masItems := index $masByCategory $category }}
  {{- if and $icloudSignedIn $masItems }}

# Install {{ $category }} Mac App Store packages
{{ range $masItems -}}
mas {{ . }}
{{ end -}}
  {{- end }}
{{- end }}
MAS_EOF

if [ "$mas_exit" -ne 0 ]; then
    any_failed=1
    print_message "warning" "brew bundle (mas) completed with errors — some packages may not be installed."
    print_message "info" "Run 'chezmoi apply' again after resolving the issue (e.g., restore network, fix broken cask entry)."
fi
{{ end }}

{{ if not $icloudSignedIn -}}
print_message "info" "Sign in to iCloud in System Settings, then run 'chezmoi apply' again to install App Store apps"
{{ end -}}

# Everything missing is now installed. Check whether anything already
# installed (tap, formula, cask, or mas) is outdated, and ask once, combined
# across all four types, before upgrading — installing missing packages
# must never silently drag in unrelated upgrades.
check_exit=0
brew bundle check --verbose --file=/dev/stdin <<'CHECK_EOF' || check_exit=$?
{{- range .packages.darwin.taps }}
tap {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{- end }}
{{- range $category := prepend .tag_choices "core" }}
  {{- $tapItems := index $tapByCategory $category }}
  {{- $brewItems := index $brewByCategory $category }}
  {{- $caskItems := index $caskByCategory $category }}
  {{- $masItems := index $masByCategory $category }}
  {{- if or $tapItems $brewItems $caskItems (and $icloudSignedIn $masItems) }}

# {{ $category }} packages
    {{- if $tapItems }}
{{ range $tapItems -}}
tap {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if $brewItems }}
{{ range $brewItems -}}
brew {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if $caskItems }}
{{ range $caskItems -}}
cask {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if and $icloudSignedIn $masItems }}
{{ range $masItems -}}
mas {{ . }}
{{ end -}}
    {{- end }}
  {{- end }}
{{- end }}
CHECK_EOF

if [ "$check_exit" -ne 0 ]; then
    if [ -t 0 ]; then
        read -p "🍺 Some installed packages have updates available — install them now? (y/N): " -n 1 -r
        echo
    else
        print_message "skip" "Non-interactive session (no TTY) — defaulting to skip package updates"
        REPLY="N"
    fi
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_message "skip" "Skipping package updates"
    else
        upgrade_exit=0
        brew bundle install --upgrade -v --file=/dev/stdin <<'UPGRADE_EOF' || upgrade_exit=$?
{{- range .packages.darwin.taps }}
tap {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{- end }}
{{- range $category := prepend .tag_choices "core" }}
  {{- $tapItems := index $tapByCategory $category }}
  {{- $brewItems := index $brewByCategory $category }}
  {{- $caskItems := index $caskByCategory $category }}
  {{- $masItems := index $masByCategory $category }}
  {{- if or $tapItems $brewItems $caskItems (and $icloudSignedIn $masItems) }}

# {{ $category }} packages
    {{- if $tapItems }}
{{ range $tapItems -}}
tap {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if $brewItems }}
{{ range $brewItems -}}
brew {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if $caskItems }}
{{ range $caskItems -}}
cask {{ . | quote }}{{ if has . $.packages.darwin.trusted }}, trusted: true{{ end }}
{{ end -}}
    {{- end }}

    {{- if and $icloudSignedIn $masItems }}
{{ range $masItems -}}
mas {{ . }}
{{ end -}}
    {{- end }}
  {{- end }}
{{- end }}
UPGRADE_EOF

        if [ "$upgrade_exit" -ne 0 ]; then
            any_failed=1
            print_message "warning" "brew bundle (upgrade) completed with errors — some packages may not be updated."
            print_message "info" "Run 'chezmoi apply' again after resolving the issue (e.g., restore network, fix broken cask entry)."
        fi
    fi
fi

# Record the failure and exit 0 so the rest of `chezmoi apply` (file updates,
# after scripts) still runs; the failure stamp re-triggers this script next time.
if [ "$any_failed" -eq 1 ]; then
    record_script_failure "brew-23"
fi
{{ end -}}
