{
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "pluginConfigs": {
    "jev-model-router@skills-dir": {
      "options": {
        "provider": "typesafe",
        "typesafeBaseUrl": "https://openrouter.ai/api",
        "typesafeModel": "~typesafe/jev-latest",
        "fastModel": "haiku",
        "balancedModel": "sonnet",
        "deepModel": "opus",
        "minUpgradeConfidence": 0.3,
        "minDowngradeConfidence": 0.6,
        "routeSubagentModel": true,
        "routeMainEffort": true,
        "routeMainModel": false,
        "timeoutMs": 800,
        "logDecisions": true
      }
    }
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__basic-memory__search_notes",
      "mcp__basic-memory__recent_activity",
      "mcp__basic-memory__list_memory_projects",
      "mcp__basic-memory__read_note"
    ]
  },
  "skillOverrides": {
    "audit-skills": "off",
    "integrate-worktrees": "off",
    "parallel-worktrees": "off"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "session-topic-capture UserPromptSubmit"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "session-topic-capture PreCompact"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "session-topic-capture SessionEnd"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "claude-tooling-write-guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "check-claude-overrides --session-start"
          }
        ]
      }
    ]
  }
}
