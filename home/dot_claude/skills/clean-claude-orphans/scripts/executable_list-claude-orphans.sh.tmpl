#!/bin/bash
# list-claude-orphans.sh — Structured view of Claude Code orphan findings (sourced directly
# from ~/.local/lib/audit-claude-code.sh, the same library audit-packages itself uses), plus
# the environment, marketplace, and plugin-scope context clean-claude-orphans needs to
# classify each orphan safely and spot decluttering candidates without re-deriving any of
# this by hand. Read-only: never installs, removes, or modifies any Claude Code state.
set -euo pipefail

{{- $localMarketplaceName := includeTemplate "local-marketplace-name" . }}

if ! command -v yq >/dev/null 2>&1; then
    echo "error: yq not found on PATH" >&2
    exit 1
fi

if ! command -v claude >/dev/null 2>&1; then
    echo "error: claude not found on PATH" >&2
    exit 1
fi

source "$HOME/.local/lib/audit-claude-code.sh"

# ---------------------------------------------------------------------------
# Claude Code environments present on this machine (openspec/specs/claude-environments).
# One object per dir with `current` marked inline, rather than a separate "current" vs
# "found" line for the same dir — avoids listing the active persona twice under two
# different labels.
# ---------------------------------------------------------------------------
echo "## environments"
current_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
current_seen=0
for dir in "${CLAUDE_PERSONA_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    if [[ "$dir" == "$current_dir" ]]; then
        is_current=true
        current_seen=1
    else
        is_current=false
    fi
    jq -cn --arg path "$dir" --argjson current "$is_current" '{path: $path, current: $current}'
done
if [[ "$current_seen" -eq 0 ]]; then
    # $CLAUDE_CONFIG_DIR points somewhere outside the declared persona list — still
    # report it as the current environment rather than silently dropping it.
    jq -cn --arg path "$current_dir" '{path: $path, current: true}'
fi

# ---------------------------------------------------------------------------
# This repo's own marketplace catalog. Plugins installed from {{ $localMarketplaceName }} are
# already declared here, outside packages.yaml — never suggest DECLAREing them. Bundled
# skills are listed too, so a skill orphan that duplicates a bundle can be spotted without
# re-reading marketplace.json by hand. The ## orphans section below tags matching skill
# orphans inline itself (claude_orphan_skills_jsonl calls claude_chezmoi_personal_plugins_jsonl
# internally), so there's no local plumbing variable to build here.
# ---------------------------------------------------------------------------
echo ""
echo "## {{ $localMarketplaceName }}-plugins"
claude_chezmoi_personal_plugins_jsonl

# ---------------------------------------------------------------------------
# Skills managed by this repo's own chezmoi source (deployed via `chezmoi apply`),
# never installed through `npx skills add` — not orphans of that mechanism, and
# packages.yaml's `skills:` list was never meant to track them. The ## orphans section
# below tags matches inline itself (claude_orphan_skills_jsonl excludes these names
# internally), so there's no local plumbing variable to build here.
# ---------------------------------------------------------------------------
echo ""
echo "## chezmoi-managed-skills"
claude_chezmoi_managed_skill_names | jq -Rnc '[inputs] | .[] | {name: .}'

# ---------------------------------------------------------------------------
# Every currently installed plugin's scope, owning project (for project/local scope),
# enabled state, and whether it's sourced from this repo's own {{ $localMarketplaceName }}
# marketplace (`.id` ends `@{{ $localMarketplaceName }}` — never a DECLARE candidate, see SKILL.md
# Step 3). This is what uninstalling actually needs: user-scope plugins uninstall
# directly; project/local-scope plugins require clearing the `enabledPlugins` entry from
# the owning project's settings file first (`.claude/settings.json` for project scope,
# `.claude/settings.local.json` for local scope — determined by `scope` alone, no extra
# lookup needed), then `claude plugins uninstall <id> --scope <project|local>` run with
# cwd inside that project. Without this, all three facts have to be rediscovered by
# trial and error.
#
# Sourced from `claude plugins list --json` — the same live CLI `audit-packages` itself
# reads to build ## orphans below — rather than the on-disk installed_plugins.json file,
# which silently omits plugins installed from a directory-style marketplace (a standalone
# skill installed as its own "plugin"): those still show up in ## orphans, but used to be
# missing here, leaving their scope to be rediscovered by hand. The `enabled` column also
# replaces a separate settings.json/settings.local.json cross-check this script used to
# do itself: `claude plugins list --json` already reports whether a project/local-scope
# install is currently active, so there's nothing left to re-derive.
# ---------------------------------------------------------------------------
echo ""
echo "## installed-plugins"
claude_installed_plugins_jsonl

# ---------------------------------------------------------------------------
# Orphans across the four Claude Code categories, sourced directly from
# scripts/audit-claude-code.sh's functions rather than parsing `audit-packages`' freeform
# text output. This skill exists to find what's installed but *not chezmoi-managed* — not
# declared in packages.yaml, not listed in ## {{ $localMarketplaceName }}-plugins, not found in
# ## chezmoi-managed-skills — which is a different question from whether something is
# currently enabled. Each category's `claude_orphan_*_jsonl` function already applies this
# filtering internally (chezmoi-managed skill names and {{ $localMarketplaceName }}-suffixed plugin
# ids are excluded at the source, not merely tagged — see that function's own comments), so
# there's no awk/jq reshaping left to do here.
#
# Order matches today's category ordering (mcp_server, plugin, marketplace, skill).
# mcp_server and skill are guarded by their precondition function so a missing
# precondition (no settings.json / no skills dir) skips silently instead of crashing under
# `set -e`; plugin and marketplace have no precondition function because they had no skip
# path before this change either — they always ran unconditionally.
# ---------------------------------------------------------------------------
echo ""
echo "## orphans"
# `&&`-chaining a precondition check doesn't skip silently the way it looks like it should:
# `set -e` doesn't abort on a failed left-hand side, but the chain's own exit status still
# becomes the *script's* exit status when it's the last command run — a missing skills dir
# would make this entire read-only script report failure even though its output was
# complete and correct. Plain `if` blocks avoid that.
if claude_mcp_settings_present; then claude_orphan_mcp_servers_jsonl; fi
claude_orphan_plugins_jsonl
claude_orphan_marketplaces_jsonl
if claude_skills_dir_present; then claude_orphan_skills_jsonl; fi
