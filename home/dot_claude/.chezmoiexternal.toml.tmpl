{{- if and (eq .chezmoi.os "darwin") (has "ai" .tags) -}}
{{- $modFile := dict "type" "file" "refreshPeriod" "168h" -}}
{{- $modBase := "https://raw.githubusercontent.com/davila7/claude-code-templates/c3a74d3ef9ed8076eeb1e3370cc0fc0cc398bdfa/cli-tool/components/mods/productivity/jev-model-router" -}}

# jev-model-router: chezmoi vendors these files and the non-secret
# pluginConfigs["jev-model-router@skills-dir"].options in each persona's
# .claude-settings.json, but NOT its API key (never chezmoi-managed — see
# openspec/specs/claude-function-hooks-mods "A mod's secret credentials are
# never chezmoi-managed"). After `chezmoi apply` on a new machine or persona,
# run once per persona to get real Jev routing instead of the built-in
# classifier fallback:
#   /plugin configure jev-model-router@skills-dir
#   /reload-plugins
# The pluginConfigs key MUST be the full loaded id ("<name>@skills-dir"),
# not the bare mod name — Claude Code silently ignores options declared
# under the bare name (see design.md's 2026-09-26 correction).
#
# $modBase is pinned to a commit SHA, not "main" — this is executable content
# (hooks run on every tool call), so an upstream compromise or breaking
# change must not land via a plain `chezmoi apply`. See
# openspec/specs/external-dependency-pinning/ for the requirement and the
# update procedure (resolve the new HEAD SHA with `git ls-remote
# https://github.com/davila7/claude-code-templates.git main`, then replace
# the SHA segment in $modBase above).

["skills/jev-model-router/.claude-plugin/plugin.json"]
    {{- toToml $modFile | nindent 4 }}
    url = "{{ $modBase }}/.claude-plugin/plugin.json"

["skills/jev-model-router/hooks/hooks.json"]
    {{- toToml $modFile | nindent 4 }}
    url = "{{ $modBase }}/hooks/hooks.json"

["skills/jev-model-router/hooks/jev-model-router.ts"]
    {{- toToml $modFile | nindent 4 }}
    url = "{{ $modBase }}/hooks/jev-model-router.ts"

["skills/jev-model-router/hooks/policy.ts"]
    {{- toToml $modFile | nindent 4 }}
    url = "{{ $modBase }}/hooks/policy.ts"
{{- end }}
