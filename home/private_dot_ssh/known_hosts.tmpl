{{- $settings := includeTemplate "machine-settings" . | fromJson -}}
{{- $secretEntries := default dict (index $settings "secret_entries") -}}
{{- $sshEntryName := index $secretEntries "ssh" -}}
{{- if and $sshEntryName .has_keepassxc_db -}}
{{- keepassxcAttribute $sshEntryName "known_hosts" -}}
{{- end }}
