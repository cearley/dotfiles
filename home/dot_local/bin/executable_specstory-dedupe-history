#!/usr/bin/env python3
"""Find and safely remove duplicate SpecStory session files.

SpecStory's Stop-hook resync, and its own title/slug renaming mid-session, can leave
two `.md` files in the same `.specstory/history/` for one session: an abandoned
earlier write and the file that superseded it. This tool finds every such pair across
every project on the machine (or under one given root), groups them by the session
UUID embedded in each file's header, and flags the smaller file as safe to remove only
when its complete bytes are an exact prefix of the larger file's bytes. Anything that
shares a UUID but isn't a clean byte-prefix relationship is left for manual review —
never auto-resolved, with or without --apply.

Dry run (report only, deletes nothing) is the default. Pass --apply to delete the
files identified as safe.
"""
from __future__ import annotations

import argparse
import itertools
import re
import subprocess
import sys
from pathlib import Path

UUID_HEADER_RE = re.compile(
    r"(?:Claude Code )?Session ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})"
)
# The header line appears within the first few hundred bytes; capped well above that
# so a slow read never has to scan a multi-megabyte transcript.
HEADER_PEEK_BYTES = 4096


def discover_history_dirs(root: Path) -> list[Path]:
    try:
        result = subprocess.run(
            # --no-ignore-vcs: .specstory/ is gitignored in virtually every project (it's
            # session data, not something to commit), so a plain --hidden search silently
            # finds nothing -- this flag makes fd traverse it anyway.
            ["fd", "--hidden", "--no-ignore-vcs", "--type", "d", "--full-path",
             r"\.specstory/history$", str(root)],
            capture_output=True, text=True, check=True,
        )
    except FileNotFoundError:
        sys.exit("ERROR: `fd` is not installed or not on PATH.")
    except subprocess.CalledProcessError as exc:
        sys.exit(f"ERROR: fd failed: {exc.stderr.strip()}")
    return [Path(line) for line in result.stdout.splitlines() if line]


def extract_session_uuid(path: Path) -> str | None:
    try:
        with path.open("rb") as fh:
            head = fh.read(HEADER_PEEK_BYTES)
    except OSError:
        return None
    match = UUID_HEADER_RE.search(head.decode("utf-8", errors="replace"))
    return match.group(1) if match else None


def group_by_session(history_dir: Path) -> dict[str, list[Path]]:
    """Every `*.md` under `history_dir`, grouped by embedded session UUID.

    Only groups with 2+ files are kept -- a lone file has nothing to compare against.
    """
    groups: dict[str, list[Path]] = {}
    for md in sorted(history_dir.rglob("*.md")):
        uuid = extract_session_uuid(md)
        if uuid is None:
            continue
        groups.setdefault(uuid, []).append(md)
    return {uuid: files for uuid, files in groups.items() if len(files) >= 2}


class SafeDuplicate:
    def __init__(self, duplicate: Path, keeper: Path, bytes_reclaimed: int):
        self.duplicate = duplicate
        self.keeper = keeper
        self.bytes_reclaimed = bytes_reclaimed


class Conflict:
    def __init__(self, uuid: str, files: tuple[Path, Path]):
        self.uuid = uuid
        self.files = files


def classify_group(uuid: str, files: list[Path]) -> tuple[list[SafeDuplicate], list[Conflict]]:
    """Split one UUID group into safe-to-remove duplicates and unresolved conflicts.

    Smallest-first: a file is marked safe the moment its full bytes are an exact
    prefix of some larger sibling's bytes (the first such sibling found, in ascending
    size order). Any pair where neither file explains the other is a conflict --
    deliberately never guessed at, even when sizes are close.
    """
    by_size = sorted(files, key=lambda f: f.stat().st_size)
    contents = {f: f.read_bytes() for f in by_size}

    resolved: dict[Path, Path] = {}
    for i, small in enumerate(by_size):
        if small in resolved:
            continue
        for large in by_size[i + 1:]:
            if contents[large].startswith(contents[small]):
                resolved[small] = large
                break

    safe = [
        SafeDuplicate(duplicate=dup, keeper=keeper, bytes_reclaimed=len(contents[dup]))
        for dup, keeper in resolved.items()
    ]

    conflicts = []
    for a, b in itertools.combinations(by_size, 2):
        if a in resolved or b in resolved:
            continue
        conflicts.append(Conflict(uuid=uuid, files=(a, b)))

    return safe, conflicts


def scan(history_dirs: list[Path]) -> tuple[list[SafeDuplicate], list[Conflict]]:
    all_safe: list[SafeDuplicate] = []
    all_conflicts: list[Conflict] = []
    for history_dir in history_dirs:
        for uuid, files in group_by_session(history_dir).items():
            safe, conflicts = classify_group(uuid, files)
            all_safe.extend(safe)
            all_conflicts.extend(conflicts)
    return all_safe, all_conflicts


def print_manifest(safe: list[SafeDuplicate], conflicts: list[Conflict]) -> None:
    if not safe and not conflicts:
        print("No duplicate session files found.")
        return

    if safe:
        print(f"Safe-to-remove duplicates ({len(safe)}):")
        for dup in safe:
            print(f"  {dup.duplicate} [{dup.bytes_reclaimed:,} bytes]")
            print(f"    -> duplicate of {dup.keeper}")
        total = sum(dup.bytes_reclaimed for dup in safe)
        print(f"  Total reclaimable: {total:,} bytes")
    else:
        print("Safe-to-remove duplicates: none")

    print()
    if conflicts:
        print(f"Conflicts needing manual review ({len(conflicts)}):")
        for conflict in conflicts:
            a, b = conflict.files
            print(f"  session {conflict.uuid}:")
            print(f"    {a}")
            print(f"    {b}")
    else:
        print("Conflicts needing manual review: none")


def apply_deletions(safe: list[SafeDuplicate]) -> None:
    if not safe:
        print("Nothing to delete.")
        return
    total = 0
    for dup in safe:
        dup.duplicate.unlink()
        total += dup.bytes_reclaimed
        print(f"Deleted {dup.duplicate} [{dup.bytes_reclaimed:,} bytes]")
    print(f"Total reclaimed: {total:,} bytes")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "root", nargs="?", default=str(Path.home()),
        help="Root to search for .specstory/history directories under (default: $HOME)",
    )
    parser.add_argument(
        "--apply", action="store_true",
        help="Delete the files identified as safe-to-remove duplicates. Default is a dry run.",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    history_dirs = discover_history_dirs(Path(args.root))
    if not history_dirs:
        print(f"No .specstory/history directories found under {args.root}.")
        return 0

    safe, conflicts = scan(history_dirs)

    if args.apply:
        apply_deletions(safe)
        if conflicts:
            print(f"\n{len(conflicts)} conflict(s) left untouched; review manually.")
    else:
        print_manifest(safe, conflicts)

    return 0


if __name__ == "__main__":
    sys.exit(main())
