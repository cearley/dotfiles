#!/bin/bash
# check-claude-overrides — Detect Claude Code skillOverrides/enabledPlugins/permissions/env entries that
# silently diverge from a persona's chezmoi-managed baseline (its
# dot_claude*/.claude-settings.json) — the mirror-image direction of the
# installed-but-undeclared drift that audit-packages/clean-claude-orphans already cover.
# Read-only by default; --fix codifies a single confirmed "keep" resolution directly into
# that source file.
#
# Rendered by chezmoi from {{ .chezmoi.sourceDir }}/dot_local/bin/executable_check-claude-overrides.tmpl —
# edit the source template, then `chezmoi apply`. The persona list and every chezmoi-source
# path below are baked in at render time from this machine's claude_envs config and
# .chezmoi.sourceDir — never hardcoded, never rediscovered at runtime.
#
# Usage: check-claude-overrides [--help]
#        check-claude-overrides --fix <persona> <skillOverrides|enabledPlugins|permissions|env> <key>
#        check-claude-overrides --session-start
set -euo pipefail
{{- $sourceDir := .chezmoi.sourceDir }}
{{- $settings := includeTemplate "machine-settings" . | fromJson }}
{{- $claudeEnvs := default (list) (index $settings "claude_envs") }}

PACKAGES_YAML="{{ $sourceDir }}/.chezmoidata/packages.yaml"
NATIVE_SKILLS_DIR="{{ $sourceDir }}/dot_claude/skills"

# Parallel arrays, one entry per checked persona: name / live config dir / managed-settings
# source file (same shape as settings.json).
# The unnamed default is always first; named personas come from this machine's claude_envs,
# baked in here at chezmoi-apply time rather than rediscovered at runtime.
PERSONA_NAMES=("default"{{ range $claudeEnvs }} "{{ trimPrefix "~/.claude-" . }}"{{ end }})
PERSONA_DIRS=("$HOME/.claude"{{ range $claudeEnvs }} "$HOME/.claude-{{ trimPrefix "~/.claude-" . }}"{{ end }})
PERSONA_BASELINES=("{{ $sourceDir }}/dot_claude/.claude-settings.json"{{ range $claudeEnvs }} "{{ $sourceDir }}/dot_claude-{{ trimPrefix "~/.claude-" . }}/.claude-settings.json"{{ end }})

print_usage() {
    cat <<'EOF'
Usage: check-claude-overrides [--help]
       check-claude-overrides --fix <persona> <skillOverrides|enabledPlugins|permissions|env> <key>

Detects entries in any ~/.claude* persona's settings.json that silently diverge from that
persona's chezmoi-managed baseline (dot_claude*/.claude-settings.json):
  - skillOverrides.<native skill> = "off" / enabledPlugins.<declared plugin> = false that
    the baseline doesn't explain — an override with no source-of-truth record;
  - a permissions.<key> / env.<key> scalar the baseline manages whose live value differs —
    a runtime change the next chezmoi apply will silently revert.

Without --fix: read-only. Prints a "## drift" section (persona<TAB>kind<TAB>key<TAB>value),
one line per unexplained entry; empty if none found.

With --fix <persona> <kind> <key>: codifies the "keep the override" resolution by writing
the live value into the target persona's .claude-settings.json, after
re-confirming the entry is currently flagged. The value is always read from the live
settings.json, never typed. Verifies the edited copy before touching the real file. Dropping
an override instead remains manual (/skill, /plugin, or letting chezmoi apply revert it) — see claude-tooling.md's "Checking
for Override Drift" section for the full resolve workflow.

With --session-start: intended for automatic invocation from a Claude Code SessionStart
hook, not interactive use. Checks only the persona matching $CLAUDE_CONFIG_DIR (never a full
sweep), and only prints a one-line plain-text pointer when that persona's drift differs from
what was last reported for it — silent on a clean or already-seen-and-unresolved state.
Never modifies settings.json or any .claude-settings.json. Always exits 0.
EOF
}

require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "error: $1 is required but not found on PATH" >&2
        exit 1
    fi
}

# Baseline: a persona's managed-settings source file, read as-is at runtime (it can change
# without a chezmoi apply having run). Fails if the file is missing or not valid JSON.
# ---------------------------------------------------------------------------
read_baseline() {
    jq -ce '.' "$1" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Reference data: native skills and packages.yaml-declared plugins
# ---------------------------------------------------------------------------
native_skills() {
    [[ -d "$NATIVE_SKILLS_DIR" ]] || return 0
    for dir in "$NATIVE_SKILLS_DIR"/*/; do
        [[ -e "$dir" ]] || continue
        basename "$dir"
    done
}

declared_plugins() {
    yq '.packages.darwin.ai.agents.claude_code.plugins[]?' "$PACKAGES_YAML" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Drift detection for one persona: prints persona\tkind\tkey\tvalue lines to stdout
# ---------------------------------------------------------------------------
detect_persona_drift() {
    local name="$1" baseline_path="$2" config_dir="$3"
    local settings_file baseline_json

    if [[ ! -f "$baseline_path" ]]; then
        echo "skip: ${name} — no managed-settings file at ${baseline_path}" >&2
        return 0
    fi

    if ! baseline_json="$(read_baseline "$baseline_path")"; then
        echo "skip: ${name} — ${baseline_path} is not valid JSON" >&2
        return 0
    fi

    settings_file="${config_dir}/settings.json"
    [[ -f "$settings_file" ]] || return 0

    while IFS= read -r skill; do
        [[ -z "$skill" ]] && continue
        if jq -e --arg s "$skill" '.skillOverrides[$s]? == "off"' "$settings_file" >/dev/null 2>&1 \
            && ! jq -e --arg s "$skill" '.skillOverrides[$s]? == "off"' <<<"$baseline_json" >/dev/null 2>&1; then
            printf '%s\tskillOverrides\t%s\toff\n' "$name" "$skill"
        fi
    done < <(native_skills)

    while IFS= read -r plugin; do
        [[ -z "$plugin" ]] && continue
        if jq -e --arg p "$plugin" '.enabledPlugins[$p]? == false' "$settings_file" >/dev/null 2>&1 \
            && ! jq -e --arg p "$plugin" '.enabledPlugins[$p]? == false' <<<"$baseline_json" >/dev/null 2>&1; then
            printf '%s\tenabledPlugins\t%s\tfalse\n' "$name" "$plugin"
        fi
    done < <(declared_plugins)

    # Managed permissions/env scalars changed at runtime — chezmoi apply would revert them.
    jq -r --argjson b "$baseline_json" --arg n "$name" '
        . as $live
        | ("permissions", "env") as $kind
        | ($b[$kind] | objects | to_entries[]) as {key: $k, value: $v}
        | select(($v | type) != "object" and ($v | type) != "array")
        | ($live[$kind] | if type == "object" and has($k) then .[$k] else empty end) as $lv
        | select($lv != $v)
        | [$n, $kind, $k, ($lv | if type == "string" then . else tojson end)] | @tsv
    ' "$settings_file" 2>/dev/null || true
}

detect_all_drift() {
    local i
    for ((i = 0; i < ${#PERSONA_NAMES[@]}; i++)); do
        detect_persona_drift "${PERSONA_NAMES[$i]}" "${PERSONA_BASELINES[$i]}" "${PERSONA_DIRS[$i]}"
    done
}

# ---------------------------------------------------------------------------
# --session-start support: resolve $CLAUDE_CONFIG_DIR against the persona arrays
# above, and track per-persona dedup state. See design.md - Decisions.
# ---------------------------------------------------------------------------

# Prints the index into PERSONA_* for the persona matching $CLAUDE_CONFIG_DIR (or
# $HOME/.claude when unset). Returns non-zero if no declared persona matches.
resolve_current_persona_index() {
    local config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    local i
    for ((i = 0; i < ${#PERSONA_DIRS[@]}; i++)); do
        if [[ "${PERSONA_DIRS[$i]}" == "$config_dir" ]]; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

drift_state_file() {
    echo "$1/.check-claude-overrides-last-drift"
}

# Reads persona\tkind\tkey\tvalue lines (detect_persona_drift's output) on stdin, drops the
# redundant persona column (the state file's location already scopes it to one persona), and
# sorts for a stable comparison.
drift_lines_without_persona() {
    awk -F'\t' 'BEGIN{OFS="\t"} {print $2,$3,$4}' | sort
}

# ---------------------------------------------------------------------------
# --session-start mode: single-persona check, dedup'd plain-text pointer, never fails a
# session over a config edge case (missing tool, unrecognized persona) — always exits 0.
# ---------------------------------------------------------------------------
run_session_start() {
    command -v jq >/dev/null 2>&1 || exit 0
    command -v yq >/dev/null 2>&1 || exit 0

    local idx
    idx="$(resolve_current_persona_index)" || exit 0

    local name="${PERSONA_NAMES[$idx]}" baseline_path="${PERSONA_BASELINES[$idx]}" config_dir="${PERSONA_DIRS[$idx]}"

    local drift_tsv
    drift_tsv="$(detect_persona_drift "$name" "$baseline_path" "$config_dir" 2>/dev/null)" || true

    local new_lines=""
    if [[ -n "$drift_tsv" ]]; then
        new_lines="$(printf '%s\n' "$drift_tsv" | drift_lines_without_persona)"
    fi

    local state_file old_lines=""
    state_file="$(drift_state_file "$config_dir")"
    [[ -f "$state_file" ]] && old_lines="$(cat "$state_file")"

    if [[ -n "$new_lines" && "$new_lines" != "$old_lines" ]]; then
        echo "Claude Code override drift detected for this persona — run check-claude-overrides for detail."
    fi

    printf '%s\n' "$new_lines" > "$state_file" 2>/dev/null || true
    exit 0
}

# ---------------------------------------------------------------------------
# --fix mode: codify a single, currently-flagged "keep" resolution into the target
# persona's managed-settings source file.
# ---------------------------------------------------------------------------
run_fix() {
    local persona="$1" kind="$2" key="$3"

    if [[ ! "$kind" =~ ^(skillOverrides|enabledPlugins|permissions|env)$ ]]; then
        echo "error: kind must be skillOverrides, enabledPlugins, permissions, or env" >&2
        exit 1
    fi

    local baseline_path="" config_dir="" i
    for ((i = 0; i < ${#PERSONA_NAMES[@]}; i++)); do
        if [[ "${PERSONA_NAMES[$i]}" == "$persona" ]]; then
            baseline_path="${PERSONA_BASELINES[$i]}"
            config_dir="${PERSONA_DIRS[$i]}"
            break
        fi
    done
    if [[ -z "$baseline_path" ]]; then
        echo "error: unknown persona '${persona}' (not the default, not in this machine's claude_envs)" >&2
        exit 1
    fi

    local flagged
    flagged="$(detect_persona_drift "$persona" "$baseline_path" "$config_dir" 2>/dev/null | K="$kind" KEY="$key" awk -F'\t' '$2==ENVIRON["K"] && $3==ENVIRON["KEY"] && !found {print; found=1}')"
    if [[ -z "$flagged" ]]; then
        echo "error: ${persona} ${kind}.${key} is not currently flagged as drift — nothing to fix" >&2
        exit 1
    fi

    local live_value
    live_value="$(jq -c --arg k "$key" ".${kind}[\$k]" "${config_dir}/settings.json")"

    local tmp_file
    tmp_file="$(mktemp)"
    if ! jq --arg kind "$kind" --arg k "$key" --argjson v "$live_value" '.[$kind][$k] = $v' \
            "$baseline_path" > "$tmp_file" \
        || [[ "$(jq -c --arg kind "$kind" --arg k "$key" '.[$kind][$k]' "$tmp_file")" != "$live_value" ]]; then
        rm -f "$tmp_file"
        echo "error: verification failed — ${kind}.${key} not written as ${live_value}; ${baseline_path} left unchanged" >&2
        exit 1
    fi

    cp -f "$tmp_file" "$baseline_path"
    rm -f "$tmp_file"
    echo "fixed: ${persona} ${kind}.${key} = ${live_value} written to ${baseline_path}"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    print_usage
    exit 0
fi

# --session-start is dispatched before require_cmd: a SessionStart hook must never fail a
# session over a missing tool, so it does its own lenient command-v checks instead (see
# run_session_start above).
if [[ "${1:-}" == "--session-start" ]]; then
    run_session_start
fi

require_cmd jq
require_cmd yq

if [[ "${1:-}" == "--fix" ]]; then
    shift
    if [[ $# -ne 3 ]]; then
        echo "error: --fix requires exactly 3 arguments: <persona> <skillOverrides|enabledPlugins|permissions|env> <key>" >&2
        exit 1
    fi
    run_fix "$1" "$2" "$3"
    exit 0
fi

echo "## drift"
detect_all_drift
