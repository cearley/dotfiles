#!/bin/bash
# hcom-herdr-register — SessionStart hook. Two independent behaviors, both
# gated on HERDR_PANE_ID (i.e. running under herdr at all):
#   1. Registration: if HCOM_INSTANCE_NAME is also set, reports this hcom
#      agent's handle to herdr's pane sidebar metadata — but only after
#      confirming HERDR_PANE_ID actually matches the pane this process is
#      running in (via `herdr pane current --current`), so a stale/spoofed/
#      inherited env var can never write another pane's metadata.
#   2. Agent map: emits a "## Herdr Agent Map" markdown table of every herdr
#      agent's pane_id, hcom token, and project directory (so the model has
#      cross-pane context at session start). Stdout here is injected into the
#      session as a system-reminder. No agent-name column: names are
#      ephemeral and usually unset at session start, so they're noise.
# No-op entirely outside herdr (HERDR_PANE_ID unset).
set -euo pipefail

if [[ -z "${HERDR_PANE_ID:-}" ]]; then
    exit 0
fi

if [[ -n "${HCOM_INSTANCE_NAME:-}" ]]; then
    actual_pane_id=$(herdr pane current --current 2>/dev/null | jq -r '.result.pane.pane_id // ""') || actual_pane_id=""
    if [[ "$actual_pane_id" == "$HERDR_PANE_ID" ]]; then
        herdr pane report-metadata "$HERDR_PANE_ID" --source hcom --token "hcom=$HCOM_INSTANCE_NAME"
    fi
fi

# Resolve a cwd's project name: basename of its git toplevel, or of the cwd
# itself outside a git repo.
resolve_project() {
    local cwd=$1 toplevel
    toplevel=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")
    basename "$toplevel"
}

agents_json=$(herdr agent list 2>/dev/null) || exit 0

rows=""
while IFS= read -r agent; do
    cwd=$(jq -r '.cwd // ""' <<<"$agent")
    [[ -z "$cwd" ]] && continue
    pane_id=$(jq -r '.pane_id // ""' <<<"$agent")
    token=$(jq -r '.tokens.hcom // ""' <<<"$agent")
    project=$(resolve_project "$cwd")
    rows+="| $pane_id | $token | $project |"$'\n'
done < <(jq -c '.result.agents[]?' <<<"$agents_json" 2>/dev/null)

if [[ -n "$rows" ]]; then
    echo "## Herdr Agent Map"
    echo
    echo "| Pane | hcom | Project |"
    echo "|---|---|---|"
    printf '%s' "$rows"
fi
