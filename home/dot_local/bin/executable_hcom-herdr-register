#!/bin/bash
# hcom-herdr-register — SessionStart hook: reports this hcom agent's handle to
# herdr's pane sidebar metadata, so the sidebar shows which hcom instance is
# running in each pane. No-op outside herdr (HERDR_PANE_ID unset) or outside an
# active hcom session (HCOM_INSTANCE_NAME unset).
set -euo pipefail

if [[ -z "${HERDR_PANE_ID:-}" || -z "${HCOM_INSTANCE_NAME:-}" ]]; then
    exit 0
fi

herdr pane report-metadata "$HERDR_PANE_ID" --source hcom --token "hcom=$HCOM_INSTANCE_NAME"
