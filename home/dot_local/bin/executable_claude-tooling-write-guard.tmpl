#!/bin/bash
# claude-tooling-write-guard — PreToolUse hook (Bash|Edit|Write|Read matcher). Redirects
# direct edits to chezmoi-managed Claude Code tooling files (settings.json, skills/,
# rules/, plugins/) to their real source, using `chezmoi managed`/`source-path`. Also
# flags reads/writes that cross profile boundaries (see "Profile mismatch" tier below).
#
# Edit/Write/Read give a structured tool_input.file_path; Bash only gives a command
# string, so mutation detection there is heuristic. A command referencing a deployed
# path that isn't a recognized mutation (a read, an unrecognized shape) falls back to an
# informational nudge, once per session. That nudge makes no permission decision —
# the call goes through Claude Code's normal permission flow. The guard never returns
# an allow decision: it can't vouch for a command it didn't classify.
#
# Tiers:
#   - Managed: file is templated/merged from a tracked source — a direct edit gets
#     silently reverted or reasserted on the next `chezmoi apply`, so proceeding is never
#     useful. permissionDecision "deny" — the reason is returned to the model as a
#     blocking tool error, not just an interactive prompt a classifier or background
#     subagent can wave through unread. Point at `source-path`.
#   - Not managed, but under plugins/ or skills/: installed/fetched per a packages.yaml
#     declaration — won't be reverted, but drifts from what a fresh install would
#     produce, and a local toggle is sometimes a deliberate choice. permissionDecision
#     "ask". Point at packages.yaml.
#   - Profile mismatch: the path belongs to a profile (settings.json/.claude.json/
#     plugins/projects/CLAUDE.md, live or chezmoi-source) other than the one
#     $CLAUDE_CONFIG_DIR says is active. skills/ and rules/ are symlink-shared across
#     every profile (see claude-tooling.md) and are never flagged. permissionDecision
#     "ask" — cross-profile work is sometimes deliberate, never silently allowed through
#     unremarked. Composes with the tiers above (appends to their message) rather than
#     replacing them; stands alone for Read, which the other tiers don't cover.
#   - Neither: out of scope, exit clean.
#
# Rendered by chezmoi from {{ .chezmoi.sourceDir }}/dot_local/bin/executable_claude-tooling-write-guard.tmpl —
# edit the source template, then `chezmoi apply`.
set -euo pipefail
{{- $sourceDir := .chezmoi.sourceDir }}
{{- $repoRoot := trimSuffix "/home" $sourceDir }}
{{- $profiles := includeTemplate "profile-list" . | fromJson }}
{{- $profileList := "~/.claude" }}
{{- range $profiles }}{{ if ne .name "default" }}{{ $profileList = printf "%s, ~/.claude-%s" $profileList .name }}{{ end }}{{ end }}

payload=$(cat)
tool_name=$(jq -r '.tool_name // ""' <<<"$payload")

emit_ask() {
    jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "ask",
      permissionDecisionReason: $reason
    }
  }'
}

emit_deny() {
    jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
}

# Dispatches a "TIER|message" string (see check_path) to emit_deny/emit_ask.
emit_by_tier() {
    local tagged="$1" tier="${1%%|*}"
    if [[ "$tier" == "DENY" ]]; then
        emit_deny "${tagged#DENY|}"
    else
        emit_ask "${tagged#ASK|}"
    fi
}

# Active profile name from $CLAUDE_CONFIG_DIR ("default" for the unnamed profile,
# empty if $CLAUDE_CONFIG_DIR is set to something unrecognized). Normalizes a
# trailing slash and resolves symlinks before matching, so "$HOME/.claude/" or a
# symlinked config dir doesn't fail to match and silently disable the check.
active_profile() {
    local dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    dir="${dir%/}"
    local real
    real=$(realpath "$dir" 2>/dev/null) && dir="$real"
    if [[ "$dir" == "$HOME/.claude" ]]; then
        echo "default"
    elif [[ "$dir" =~ ^"$HOME"/\.claude-([A-Za-z0-9_-]+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

# Which profile a path belongs to, for ONLY the categories that are NOT shared
# across profiles (settings.json, .claude.json, plugins/, projects/, CLAUDE.md, and
# the chezmoi-source equivalents under dot_claude-<name>/). skills/ and rules/ are
# symlink-shared across every profile (see "Profiles Share Skills and Rules via
# Symlink" in claude-tooling.md) — there is no "wrong profile" for those, so they
# must never be flagged. Echoes empty string if the path isn't in-scope for this
# check at all (not under any profile dir, or it's a shared skills/rules path).
# Anchored to $HOME (live) and the chezmoi source dir (source) rather than matching
# ".claude"/"dot_claude" anywhere in the path — an unrelated project's own .claude/
# dir, or a third-party repo's .claude-plugin/ manifest, must never be mistaken for
# a profile dir.
path_profile() {
    local p="$1"
    if [[ "$p" == "$HOME/.claude.json" ]]; then
        echo "default"
        return
    fi
    if [[ "$p" =~ ^"$HOME"/\.claude[A-Za-z0-9_-]*/(skills|rules)(/|$) ]] ||
        [[ "$p" =~ ^"{{ $sourceDir }}"/dot_claude[A-Za-z0-9_-]*/(skills|rules)(/|$) ]]; then
        return
    fi
    if [[ "$p" =~ ^"$HOME"/\.claude-([A-Za-z0-9_-]+)/ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$p" =~ ^"$HOME"/\.claude/ ]]; then
        echo "default"
    elif [[ "$p" =~ ^"{{ $sourceDir }}"/dot_claude-([A-Za-z0-9_-]+)/ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$p" =~ ^"{{ $sourceDir }}"/dot_claude/ ]]; then
        echo "default"
    fi
}

# Tiered guard advice for one deployed-target path (resolving profile symlinks first).
# Prints "DENY|<message>" or "ASK|<message>" if in scope (see emit_by_tier); otherwise
# prints nothing and always returns 0, so a bare `reason=$(check_path ...)` never trips
# `set -e`.
check_path() {
    local file_path="$1" tool="$2"
    case "$file_path" in
        "$HOME/.claude.json") ;;
        "$HOME"/.claude*/*) ;;
        "{{ $sourceDir }}"/dot_claude*/*) ;;
        *) return 0 ;;
    esac

    local resolved_path="$file_path" real real_parent
    if real=$(realpath "$file_path" 2>/dev/null); then
        resolved_path="$real"
    elif real_parent=$(realpath "$(dirname "$file_path")" 2>/dev/null); then
        resolved_path="${real_parent}/$(basename "$file_path")"
    fi

    local active target mismatch=""
    active=$(active_profile)
    target=$(path_profile "$resolved_path")
    if [[ -n "$active" && -n "$target" && "$active" != "$target" ]]; then
        mismatch=" Active profile is ${active} (\$CLAUDE_CONFIG_DIR); this path belongs to ${target}."
    fi

    if [[ "$tool" == "Read" ]]; then
        if [[ -n "$mismatch" ]]; then
            echo "ASK|This reads a ${target} profile's file.${mismatch}"
        fi
        return 0
    fi

    if ! command -v chezmoi >/dev/null 2>&1; then
        echo "ASK|chezmoi isn't on this hook's PATH, so managed-file detection is disabled for this call — treat this edit with extra care.${mismatch}"
        return 0
    fi

    local managed source_path
    if managed=$(chezmoi managed --path-style absolute "$resolved_path" 2>/dev/null) && [[ -n "$managed" ]]; then
        source_path=$(chezmoi source-path "$resolved_path" 2>/dev/null) || source_path="(run: chezmoi source-path \"$resolved_path\")"
        if [[ "$resolved_path" == *settings.json ]]; then
            if [[ "$tool" == "Write" ]]; then
                echo "DENY|This settings.json is chezmoi-managed. A full overwrite bypasses the modify_ merge model regardless of which keys change — edit $(dirname "${source_path}")/.claude-settings.json (read by ${source_path}) instead, then chezmoi apply.${mismatch}"
            else
                local old_string new_string old_new
                old_string=$(jq -r '.tool_input.old_string // ""' <<<"$payload" 2>/dev/null) || old_string=""
                new_string=$(jq -r '.tool_input.new_string // ""' <<<"$payload" 2>/dev/null) || new_string=""
                old_new="$old_string"$'\n'"$new_string"
                # Catches an edit whose old_string/new_string mentions a managed key
                # by name (e.g. adding a brand-new "hooks" block) AND, separately, an
                # edit whose old_string is a value nested under one of those keys
                # without mentioning the key name itself (e.g. flipping a single
                # permissions.allow entry) — compared with whitespace stripped from
                # both sides, since old_string's exact formatting rarely matches
                # jq's compact reserialization.
                local value_hit=0 managed_blob old_norm managed_norm
                if [[ -n "$old_string" ]]; then
                    managed_blob=$(jq -c '{skillOverrides, hooks, enabledPlugins, extraKnownMarketplaces, permissions, _chezmoiManaged}' "$resolved_path" 2>/dev/null) || managed_blob=""
                    if [[ -n "$managed_blob" ]]; then
                        old_norm=$(tr -d '[:space:]' <<<"$old_string")
                        managed_norm=$(tr -d '[:space:]' <<<"$managed_blob")
                        [[ -n "$old_norm" && "$managed_norm" == *"$old_norm"* ]] && value_hit=1
                    fi
                fi
                if [[ "$value_hit" == 1 ]] || grep -qE '"(skillOverrides|hooks|enabledPlugins|extraKnownMarketplaces|permissions|_chezmoiManaged)"' <<<"$old_new"; then
                    echo "DENY|skillOverrides/hooks/enabledPlugins/extraKnownMarketplaces/permissions/_chezmoiManaged in settings.json are chezmoi-managed baseline keys, not local toggles. Edit $(dirname "${source_path}")/.claude-settings.json (read by ${source_path}) instead, then chezmoi apply — a direct edit here drifts from source and gets silently overwritten or reasserted on the next apply.${mismatch}"
                elif [[ -n "$mismatch" ]]; then
                    echo "ASK|This edits a ${target} profile's settings.json.${mismatch}"
                fi
            fi
        else
            echo "DENY|This file is chezmoi-managed (tracked from ${source_path}). Editing the deployed copy directly gets silently overwritten or reasserted on the next chezmoi apply — edit the source instead.${mismatch}"
        fi
    elif [[ "$resolved_path" =~ ^(.*/\.claude[A-Za-z0-9_-]*)/plugins/ ]]; then
        local claude_dir="${BASH_REMATCH[1]}"
        echo "ASK|This file isn't itself chezmoi-tracked, but ${claude_dir}/plugins/ is populated by 'claude plugins install' per the plugin_marketplaces/plugins lists in {{ $sourceDir }}/.chezmoidata/packages.yaml. A direct edit here won't be reverted by chezmoi apply, but it drifts silently from what a fresh install would produce — edit that declaration instead.${mismatch}"
    elif [[ "$resolved_path" =~ ^(.*/\.claude[A-Za-z0-9_-]*/skills/[^/]+)(/.*)?$ ]]; then
        local skill_root="${BASH_REMATCH[1]}" claude_dir skill_managed skill_source
        claude_dir="${skill_root%/skills/*}"
        if skill_managed=$(chezmoi managed --path-style absolute "$skill_root" 2>/dev/null) && [[ -n "$skill_managed" ]]; then
            skill_source=$(chezmoi source-path "$skill_root" 2>/dev/null) || skill_source="(run: chezmoi source-path \"$skill_root\")"
            echo "DENY|This exact file isn't chezmoi-tracked yet, but its skill directory is — a native skill, sourced at ${skill_source}. Add/edit the file there instead of the deployed copy, then chezmoi apply."
        else
            echo "ASK|This file isn't itself chezmoi-tracked, but ${claude_dir}/skills/ is populated from packages.darwin.ai.agents.claude_code.skills in {{ $sourceDir }}/.chezmoidata/packages.yaml (externally-fetched skills land here, unlike native ones which chezmoi tracks directly). A direct edit here won't be reverted by chezmoi apply, but it drifts silently from what a fresh install would produce — edit that declaration instead."
        fi
    elif [[ -n "$mismatch" ]]; then
        echo "ASK|This touches a ${target} profile's file.${mismatch}"
    fi
    return 0
}

# Does this token look like one of the Claude Code tooling paths in scope —
# a deployed/live profile path ("/.claude<name>/...", ".claude.json") or a
# chezmoi-source profile path ("dot_claude<name>/...")? Shared between the Bash
# fast-filter and every extraction handler below.
_is_relevant_claude_token() {
    local t="$1"
    [[ "$t" =~ \.claude[A-Za-z0-9_-]*/ ]] && return 0
    [[ "$t" =~ dot_claude[A-Za-z0-9_-]*/ ]] && return 0
    [[ "$t" == *.claude.json ]] && return 0
    return 1
}

# Strips one layer of surrounding matching quotes from a token (best-effort —
# not shell-evaluated, so a quoted path like "$HOME/.claude/x" would otherwise
# never resolve: realpath/chezmoi see the literal quote characters and call it
# unmanaged).
_strip_quotes() {
    local s="$1"
    if ((${#s} >= 2)); then
        if [[ "${s:0:1}" == '"' && "${s: -1}" == '"' ]] || [[ "${s:0:1}" == "'" && "${s: -1}" == "'" ]]; then
            s="${s:1:-1}"
        fi
    fi
    printf '%s' "$s"
}

# Splits a whitespace-separated argument string into one token per line,
# stripping one layer of quotes per token via `xargs -n1` (best-effort — not a
# full shell parser; nested/unbalanced quoting, globs and $() are left as
# literal text). Never word-splits the string itself against the filesystem
# (a bare `for tok in $args` loop would expand a literal `*` token).
_tokenize() {
    xargs -n1 2>/dev/null <<<"$1" || true
}

# Every non-overlapping match of `pattern` within `cmd`, in declaration order.
# Rescans the remainder after each match so a later occurrence is never hidden
# by an earlier, unrelated one (e.g. two separate `rm` invocations joined by
# `&&`, or `2>/dev/null` appearing before the real `>` redirect) — bash's `=~`
# only ever returns the leftmost match, so a single non-looping test would stop
# there. `group` selects which capture group of `pattern` to pass to `handler`.
_for_each_match() {
    local cmd="$1" pattern="$2" group="$3" handler="$4"
    local remaining="$cmd" captured full_match
    while [[ "$remaining" =~ $pattern ]]; do
        # BASH_REMATCH is a single global array shared by every `=~` test in the
        # script — capture what this match needs into locals BEFORE calling the
        # handler, since the handler's own internal `=~` tests (e.g.
        # _is_relevant_claude_token) overwrite BASH_REMATCH before we'd get to
        # use it below otherwise.
        captured="${BASH_REMATCH[$group]}"
        full_match="${BASH_REMATCH[0]}"
        # The handler's own exit status (e.g. "not a relevant token") must never
        # abort this loop under `set -e` — it's a filter, not a failure.
        "$handler" "$captured" || true
        remaining="${remaining#*"$full_match"}"
    done
}

# Every _emit_* handler below always returns 0, deliberately — "no relevant
# token found" is a filter result, not a failure, and these are called as bare
# statements (both by `_for_each_match` and by each other), where a nonzero
# return would otherwise abort the whole scan under `set -e`.
_emit_if_relevant() {
    local cand
    cand=$(_strip_quotes "$1")
    if _is_relevant_claude_token "$cand"; then
        echo "$cand"
    fi
    return 0
}

_emit_last_token() {
    local last="" tok
    while IFS= read -r tok; do
        if [[ "$tok" == -* ]]; then
            continue
        fi
        last="$tok"
    done < <(_tokenize "$1")
    if [[ -n "$last" ]] && _is_relevant_claude_token "$last"; then
        echo "$last"
    fi
    return 0
}

_emit_all_tokens() {
    local tok
    while IFS= read -r tok; do
        if [[ "$tok" == -* ]]; then
            continue
        fi
        if _is_relevant_claude_token "$tok"; then
            echo "$tok"
        fi
    done < <(_tokenize "$1")
    return 0
}

# sed only mutates in place with -i/--in-place, which can appear anywhere among
# its flags (not just first) and in GNU's fused `-iSUFFIX` form; skip entirely
# if absent. When present, every remaining non-flag argument is a potential
# target — sed -i accepts multiple files, mutating each.
_emit_sed_inplace_targets() {
    local args="$1" has_inplace=0 tok
    while IFS= read -r tok; do
        case "$tok" in
            -i | -i.* | --in-place | --in-place=*) has_inplace=1 ;;
        esac
    done < <(_tokenize "$args")
    if [[ "$has_inplace" == 1 ]]; then
        _emit_all_tokens "$args"
    fi
    return 0
}

# Best-effort mutation-target extraction for a Bash command string: emits every
# in-scope candidate path found (one per line), scoped to each matched
# construct's OWN argument list — never a global scan of the whole command
# line, which would mistake a managed path that's only read earlier (e.g.
# `cat file > /tmp/x`, `cp file /tmp/x` — a plain backup) for the write
# destination just because it's the only/last `.claude*/...`-shaped token
# present. The caller checks every candidate, not just the first.
extract_bash_targets() {
    local cmd="$1"

    # Redirect: >, >> — destination is the token immediately after the operator.
    _for_each_match "$cmd" '\>{1,2}[[:space:]]*([^[:space:];\&\|]+)' 1 _emit_if_relevant

    # mv: EVERY non-flag token is a potential target — both the destination
    # (written) and every source (removed from its current, possibly managed,
    # location), unlike cp below.
    _for_each_match "$cmd" '(^|[;\&\|[:space:]])mv[[:space:]]+([^;\&\|]+)' 2 _emit_all_tokens

    # cp: destination is the LAST token of that invocation's own argument list
    # (cp always takes the destination last, even with multiple sources) — the
    # source is only read, a common way to take a quick backup first.
    _for_each_match "$cmd" '(^|[;\&\|[:space:]])cp[[:space:]]+([^;\&\|]+)' 2 _emit_last_token

    # sed -i: see _emit_sed_inplace_targets.
    _for_each_match "$cmd" '(^|[;\&\|[:space:]])sed[[:space:]]+([^;\&\|]+)' 2 _emit_sed_inplace_targets

    # tee/rm: every non-flag token of that invocation's own argument list is a
    # potential target (tee can write multiple files; rm can delete multiple).
    _for_each_match "$cmd" '(^|[;\&\|[:space:]])(tee|rm)[[:space:]]+([^;\&\|]+)' 3 _emit_all_tokens

    return 0
}

case "$tool_name" in
    Edit | Write | Read)
        file_path=$(jq -r '.tool_input.file_path // ""' <<<"$payload")
        [[ -z "$file_path" ]] && exit 0
        reason=$(check_path "$file_path" "$tool_name")
        [[ -z "$reason" ]] && exit 0
        emit_by_tier "$reason"
        ;;
    Bash)
        command=$(jq -r '.tool_input.command // ""' <<<"$payload")
        [[ -z "$command" ]] && exit 0

        # `chezmoi add` of a modify_ target replaces the merge script with a full snapshot
        # (with --force, silently); re-add is a no-op there. Either way it's the wrong tool.
        add_pattern='(^|[;&|[:space:]])chezmoi[[:space:]]+([^;&|]*[[:space:]])?(add|re-add)[[:space:]][^;&|]*\.claude[A-Za-z0-9_-]*/settings\.json'
        if [[ "$command" =~ $add_pattern ]]; then
            emit_deny "A profile settings.json is a chezmoi modify_ target: chezmoi add would replace its merge script with a full snapshot of the live file (runtime keys included), and re-add does nothing. Edit the .claude-settings.json next to that profile's modify_settings.json.tmpl ({{ $sourceDir }}/dot_claude*/) instead, then chezmoi apply."
            exit 0
        fi

        # Raw command text, not shell-evaluated — expand $CLAUDE_CONFIG_DIR and $HOME
        # (both forms) manually before scanning, since realpath/chezmoi would otherwise
        # see a nonexistent path and call it unmanaged. $CLAUDE_CONFIG_DIR is the
        # canonical way to reference the *active* profile's dir and never contains the
        # literal substring ".claude" itself, so it has to be expanded before either the
        # fast filter or the extraction can see it.
        config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
        expanded="$command"
        expanded="${expanded//\$\{CLAUDE_CONFIG_DIR\}/$config_dir}"
        expanded="${expanded//\$CLAUDE_CONFIG_DIR/$config_dir}"
        expanded="${expanded//\$\{HOME\}/$HOME}"
        expanded="${expanded//\$HOME/$HOME}"

        # Does this command reference a deployed .claude*/..., a source dot_claude*/...,
        # or a bare .claude.json path at all?
        broad_pattern='(\.claude[A-Za-z0-9_-]*/(settings\.json|plugins/|skills/|rules/)|\.claude\.json|dot_claude[A-Za-z0-9_-]*/)'
        [[ "$expanded" =~ $broad_pattern ]] || exit 0

        # "Write" semantics: Bash has no old_string/new_string to key-filter against, so
        # settings.json always takes the blanket "any change is risky" path here. A deny
        # on any candidate is decisive; otherwise the first ask (if any) wins.
        deny_reason="" ask_reason="" target=""
        while IFS= read -r target; do
            [[ -z "$target" ]] && continue
            target="${target/#\~/$HOME}"
            reason=$(check_path "$target" "Write")
            [[ -z "$reason" ]] && continue
            if [[ "$reason" == DENY\|* ]]; then
                deny_reason="$reason"
                break
            elif [[ -z "$ask_reason" ]]; then
                ask_reason="$reason"
            fi
        done < <(extract_bash_targets "$expanded")

        reason="${deny_reason:-$ask_reason}"
        if [[ -n "$reason" ]]; then
            emit_by_tier "$reason"
            exit 0
        fi

        # Informational fallback, once per session: a read, an unrecognized mutation shape,
        # or a legitimate source-tree edit.
        session_id=$(jq -r '.session_id // ""' <<<"$payload")
        if [[ -n "$session_id" ]]; then
            marker_dir="${TMPDIR:-/tmp}/claude-tooling-write-guard"
            marker_file="$marker_dir/$session_id"
            mkdir -p "$marker_dir" 2>/dev/null || true
            find "$marker_dir" -type f -mtime +7 -delete 2>/dev/null || true
            [ -e "$marker_file" ] && exit 0
            touch "$marker_file" 2>/dev/null || true
        fi

        # Covers what the tiers above don't: cross-profile scope, and the two drift-audit
        # skills for scenarios this hook doesn't resolve itself.
        message="This command touches Claude Code tooling that the chezmoi dotfiles repo at {{ $repoRoot }} manages. This machine runs independent profiles ({{ $profileList }}) — settings.json/plugins/.claude.json aren't shared between them, so a check scoped to one won't see the others. For installed-but-undeclared drift see the clean-claude-orphans skill; for declared-but-locally-suppressed drift see check-claude-overrides."
        jq -n --arg message "$message" '{
    hookSpecificOutput: { hookEventName: "PreToolUse", additionalContext: $message },
    systemMessage: $message
  }'
        ;;
esac
