#!/bin/bash
# claude-tooling-write-guard — PreToolUse hook (Bash|Edit|Write). Denies direct edits to
# chezmoi-managed Claude Code tooling files, pointing at the real source via `chezmoi
# managed`/`source-path`. Never auto-approves.
#
# Single-purpose: managed-file protection only. Cross-profile mismatch detection lives in
# the sibling hook claude-profile-mismatch-guard; installed-but-undeclared/suppressed drift
# under plugins/skills is clean-claude-orphans/check-claude-overrides' job — neither is
# this hook's concern.
#
# Edit/Write give a structured file_path; Bash only gives a command string, so mutation
# detection there is heuristic (see claude-bash-mutation-target-extraction) — an
# unrecognized shape falls back to a once-per-session informational nudge, never a
# permission decision.
#
# Rendered by chezmoi from {{ .chezmoi.sourceDir }}/dot_local/bin/executable_claude-tooling-write-guard.tmpl.
set -euo pipefail
{{- $sourceDir := .chezmoi.sourceDir }}
{{- $repoRoot := trimSuffix "/home" $sourceDir }}

payload=$(cat)
tool_name=$(jq -r '.tool_name // ""' <<<"$payload")

emit_ask() {
    jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "ask",
      permissionDecisionReason: $reason
    }
  }'
}

emit_deny() {
    jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: $reason
    }
  }'
}

# Dispatches a "TIER|message" string (see check_path) to emit_deny/emit_ask.
emit_by_tier() {
    local tagged="$1" tier="${1%%|*}"
    if [[ "$tier" == "DENY" ]]; then
        emit_deny "${tagged#DENY|}"
    else
        emit_ask "${tagged#ASK|}"
    fi
}

# Falls back to a realpath'd dirname + basename if the path doesn't exist yet (a Write
# target that hasn't been created).
resolve_check_path() {
    local file_path="$1"
    local resolved_path="$file_path" real real_parent
    if real=$(realpath "$file_path" 2>/dev/null); then
        resolved_path="$real"
    elif real_parent=$(realpath "$(dirname "$file_path")" 2>/dev/null); then
        resolved_path="${real_parent}/$(basename "$file_path")"
    fi
    echo "$resolved_path"
}

# Whether old_string/new_string touches a chezmoi-managed baseline key — by naming it
# directly, or via a nested value without the key name itself (e.g. one permissions.allow
# entry) — compared whitespace-stripped, since old_string rarely matches jq's reserialization.
_settings_json_managed_key_touched() {
    local old_string="$1" new_string="$2" resolved_path="$3"
    local old_new="$old_string"$'\n'"$new_string"
    local value_hit=0 managed_blob old_norm managed_norm
    if [[ -n "$old_string" ]]; then
        managed_blob=$(jq -c '{skillOverrides, hooks, enabledPlugins, extraKnownMarketplaces, permissions, _chezmoiManaged}' "$resolved_path" 2>/dev/null) || managed_blob=""
        if [[ -n "$managed_blob" ]]; then
            old_norm=$(tr -d '[:space:]' <<<"$old_string")
            managed_norm=$(tr -d '[:space:]' <<<"$managed_blob")
            [[ -n "$old_norm" && "$managed_norm" == *"$old_norm"* ]] && value_hit=1
        fi
    fi
    [[ "$value_hit" == 1 ]] || grep -qE '"(skillOverrides|hooks|enabledPlugins|extraKnownMarketplaces|permissions|_chezmoiManaged)"' <<<"$old_new"
}

# Write always denies (bypasses the modify_ merge model regardless of which keys change);
# Edit denies only on a managed-key touch. Reads $payload (script-global).
check_managed_settings_json() {
    local resolved_path="$1" tool="$2" source_path="$3"
    if [[ "$tool" == "Write" ]]; then
        echo "DENY|This settings.json is chezmoi-managed. A full overwrite bypasses the modify_ merge model regardless of which keys change — edit $(dirname "${source_path}")/.claude-settings.json (read by ${source_path}) instead, then chezmoi apply."
        return 0
    fi

    local old_string new_string
    old_string=$(jq -r '.tool_input.old_string // ""' <<<"$payload" 2>/dev/null) || old_string=""
    new_string=$(jq -r '.tool_input.new_string // ""' <<<"$payload" 2>/dev/null) || new_string=""
    if _settings_json_managed_key_touched "$old_string" "$new_string" "$resolved_path"; then
        echo "DENY|skillOverrides/hooks/enabledPlugins/extraKnownMarketplaces/permissions/_chezmoiManaged in settings.json are chezmoi-managed baseline keys, not local toggles. Edit $(dirname "${source_path}")/.claude-settings.json (read by ${source_path}) instead, then chezmoi apply — a direct edit here drifts from source and gets silently overwritten or reasserted on the next apply."
    fi
    return 0
}

# Dispatches to the settings.json-specific handler above, or a generic managed-file DENY.
check_managed_file() {
    local resolved_path="$1" tool="$2"
    local source_path
    source_path=$(chezmoi source-path "$resolved_path" 2>/dev/null) || source_path="(run: chezmoi source-path \"$resolved_path\")"
    if [[ "$resolved_path" == *settings.json ]]; then
        check_managed_settings_json "$resolved_path" "$tool" "$source_path"
    else
        echo "DENY|This file is chezmoi-managed (tracked from ${source_path}). Editing the deployed copy directly gets silently overwritten or reasserted on the next chezmoi apply — edit the source instead."
    fi
}

# Prints "DENY|<message>"/"ASK|<message>" if in scope, else nothing; always returns 0 so a
# bare `reason=$(check_path ...)` never trips `set -e`.
check_path() {
    local file_path="$1" tool="$2"
    case "$file_path" in
        "$HOME"/.claude*/*) ;;
        "{{ $sourceDir }}"/dot_claude*/*) ;;
        *) return 0 ;;
    esac

    local resolved_path
    resolved_path=$(resolve_check_path "$file_path")

    # chezmoi unavailable: fail safe with ask rather than silently assuming unmanaged.
    if ! command -v chezmoi >/dev/null 2>&1; then
        echo "ASK|chezmoi isn't on this hook's PATH, so managed-file detection is disabled for this call — treat this edit with extra care."
        return 0
    fi

    local managed
    if managed=$(chezmoi managed --path-style absolute "$resolved_path" 2>/dev/null) && [[ -n "$managed" ]]; then
        check_managed_file "$resolved_path" "$tool"
    fi
    return 0
}

{{ includeTemplate "claude-bash-mutation-target-extraction" . }}
case "$tool_name" in
    Edit | Write)
        file_path=$(jq -r '.tool_input.file_path // ""' <<<"$payload")
        [[ -z "$file_path" ]] && exit 0
        reason=$(check_path "$file_path" "$tool_name")
        [[ -z "$reason" ]] && exit 0
        emit_by_tier "$reason"
        ;;
    Bash)
        command=$(jq -r '.tool_input.command // ""' <<<"$payload")
        [[ -z "$command" ]] && exit 0

        # chezmoi add would replace a profile settings.json's merge script with a full
        # live snapshot (re-add is a no-op there) — wrong tool either way.
        add_pattern='(^|[;&|[:space:]])chezmoi[[:space:]]+([^;&|]*[[:space:]])?(add|re-add)[[:space:]][^;&|]*\.claude[A-Za-z0-9_-]*/settings\.json'
        if [[ "$command" =~ $add_pattern ]]; then
            emit_deny "A profile settings.json is a chezmoi modify_ target: chezmoi add would replace its merge script with a full snapshot of the live file (runtime keys included), and re-add does nothing. Edit the .claude-settings.json next to that profile's modify_settings.json.tmpl ({{ $sourceDir }}/dot_claude*/) instead, then chezmoi apply."
            exit 0
        fi

        # Expand $CLAUDE_CONFIG_DIR/$HOME manually -- raw command text isn't shell-evaluated,
        # and $CLAUDE_CONFIG_DIR never contains a literal ".claude" for the filters below to see.
        config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
        expanded="$command"
        expanded="${expanded//\$\{CLAUDE_CONFIG_DIR\}/$config_dir}"
        expanded="${expanded//\$CLAUDE_CONFIG_DIR/$config_dir}"
        expanded="${expanded//\$\{HOME\}/$HOME}"
        expanded="${expanded//\$HOME/$HOME}"

        broad_pattern='(\.claude[A-Za-z0-9_-]*/(settings\.json|plugins/|skills/|rules/)|\.claude\.json|dot_claude[A-Za-z0-9_-]*/)'
        [[ "$expanded" =~ $broad_pattern ]] || exit 0

        # No old_string/new_string to key-filter against in Bash, so settings.json always
        # takes the blanket "any change is risky" path. Deny on any candidate is decisive;
        # otherwise the first ask (if any) wins.
        deny_reason="" ask_reason="" target=""
        while IFS= read -r target; do
            [[ -z "$target" ]] && continue
            target="${target/#\~/$HOME}"
            reason=$(check_path "$target" "Write")
            [[ -z "$reason" ]] && continue
            if [[ "$reason" == DENY\|* ]]; then
                deny_reason="$reason"
                break
            elif [[ -z "$ask_reason" ]]; then
                ask_reason="$reason"
            fi
        done < <(extract_bash_targets "$expanded")

        reason="${deny_reason:-$ask_reason}"
        if [[ -n "$reason" ]]; then
            emit_by_tier "$reason"
            exit 0
        fi

        # Informational fallback, once per session: a read, an unrecognized mutation shape,
        # or a legitimate source-tree edit.
        session_id=$(jq -r '.session_id // ""' <<<"$payload")
        if [[ -n "$session_id" ]]; then
            marker_dir="${TMPDIR:-/tmp}/claude-tooling-write-guard"
            marker_file="$marker_dir/$session_id"
            mkdir -p "$marker_dir" 2>/dev/null || true
            find "$marker_dir" -type f -mtime +7 -delete 2>/dev/null || true
            [ -e "$marker_file" ] && exit 0
            touch "$marker_file" 2>/dev/null || true
        fi

        message="This command touches Claude Code tooling that the chezmoi dotfiles repo at {{ $repoRoot }} manages. For installed-but-undeclared drift see the clean-claude-orphans skill; for declared-but-locally-suppressed drift see check-claude-overrides. Cross-profile mismatches are flagged separately by claude-profile-mismatch-guard, not this hook."
        jq -n --arg message "$message" '{
    hookSpecificOutput: { hookEventName: "PreToolUse", additionalContext: $message },
    systemMessage: $message
  }'
        ;;
esac
