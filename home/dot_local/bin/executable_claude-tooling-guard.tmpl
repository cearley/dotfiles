#!/bin/bash
# claude-tooling-guard — PreToolUse hook (Bash matcher). Points the model at
# claude-tooling.md when a Bash command edits Claude Code skill/MCP/plugin
# config (jq/mv/sed/etc.), bypassing the path-frontmatter auto-load that
# normally triggers that rule for Read/Edit/Write.
#
# Emits a short pointer rather than inlining the full guidance: large
# PreToolUse additionalContext/systemMessage payloads get truncated to a
# preview with the rest saved to a file, and a model that reads only the
# preview can silently miss it. Guidance content lives solely in
# dot_claude/rules/claude-tooling.md.tmpl — edit that, not this script.
# Never blocks; a per-session marker file dedupes repeat delivery.
#
# Rendered by chezmoi from {{ .chezmoi.sourceDir }}/dot_local/bin/executable_claude-tooling-guard.tmpl —
# edit the source template, then `chezmoi apply`.
set -euo pipefail

payload=$(cat)

# Cheap check first — extract command/session_id and test in bash, so the common
# non-matching case skips the heredoc load and jq build below. @tsv escapes tabs/
# newlines within a field as literal `\t`/`\n`, so splitting on a real tab is safe.
IFS=$'\t' read -r command session_id <<<"$(jq -r '[(.tool_input.command // ""), (.session_id // "")] | @tsv' <<<"$payload")"

pattern='\.claude[A-Za-z0-9_-]*/settings\.json|\.claude[A-Za-z0-9_-]*/\.claude\.json|\.chezmoidata/packages\.yaml|dot_claude(-[A-Za-z0-9_-]+)?/'
[[ -z "$command" || ! "$command" =~ $pattern ]] && exit 0

# Skip if already delivered this session. Checked before the heredoc load, so a
# repeat match is as cheap as a non-match. Fail open on marker errors — never
# block the tool call over a tmpfile issue.
if [ -n "$session_id" ]; then
  marker_dir="${TMPDIR:-/tmp}/claude-tooling-guard"
  marker_file="$marker_dir/$session_id"
  mkdir -p "$marker_dir" 2>/dev/null || true
  find "$marker_dir" -type f -mtime +7 -delete 2>/dev/null || true
  [ -e "$marker_file" ] && exit 0
  touch "$marker_file" 2>/dev/null || true
fi

rule_file="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/rules/claude-tooling.md"

# systemMessage alone is not confirmed to reach model context on PreToolUse hooks
# (only confirmed to render in the terminal UI, collapsed). additionalContext inside
# hookSpecificOutput is the field verified — by direct test, not just a bug report —
# to actually land in the model's context. Emit both: additionalContext so Claude
# reliably sees it, systemMessage so it's visible in the transcript too. Message is
# kept short and self-contained (no heredoc needed) — see header comment for why.
jq -n -r --arg rule_file "$rule_file" '
  (
    "This command touches Claude Code skill/MCP/plugin config that this machine'\''s chezmoi dotfiles repo manages — skills, MCP servers, and plugins are declared in packages.yaml, so local disables (e.g. /mcp disable, skillOverrides) drift from that declared state and get silently overwritten on the next chezmoi apply. The rules file also explains when the correct action is editing packages.yaml rather than a local disable at all. Without reading it first you may propose the wrong fix. Read " + $rule_file + " now (via the Read tool) before proceeding, if you have not already loaded it this session. This is required, not optional; do not proceed until it has been read."
  ) as $message
  | {
      hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "allow", additionalContext: $message },
      systemMessage: $message
    } | tojson
'
