#!/bin/bash
{{- $notSharedCategories := includeTemplate "claude-profile-not-shared-categories" . | fromJson }}
{{- $guardScopedCategories := list }}
{{- range $notSharedCategories }}{{ if ne . ".claude.json" }}{{ $guardScopedCategories = append $guardScopedCategories . }}{{ end }}{{ end }}
# claude-profile-mismatch-guard — PreToolUse hook (Bash|Edit|Write|Read). Asks when a
# read/write crosses Claude Code profile boundaries. Only ever asks or stays silent — never
# denies, never checks chezmoi-managed status. Sibling to claude-tooling-write-guard.
#
# In scope: {{ $guardScopedCategories | join ", " }} (live or chezmoi-source); `.claude.json`
# and symlink-shared skills/rules are excluded (see claude-tooling.md for why).
#
# Rendered by chezmoi from {{ .chezmoi.sourceDir }}/dot_local/bin/executable_claude-profile-mismatch-guard.tmpl.
set -euo pipefail
{{- $sourceDir := .chezmoi.sourceDir }}

payload=$(cat)
tool_name=$(jq -r '.tool_name // ""' <<<"$payload")

emit_ask() {
    jq -n --arg reason "$1" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "ask",
      permissionDecisionReason: $reason
    }
  }'
}

# "default" for the unnamed profile, empty if unrecognized. Resolves symlinks and strips a
# trailing slash first, so "$HOME/.claude/" still matches.
active_profile() {
    local dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    dir="${dir%/}"
    local real
    real=$(realpath "$dir" 2>/dev/null) && dir="$real"
    if [[ "$dir" == "$HOME/.claude" ]]; then
        echo "default"
    elif [[ "$dir" =~ ^"$HOME"/\.claude-([A-Za-z0-9_-]+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}

# Which profile a path belongs to, for the categories NOT shared across profiles
# ({{ $guardScopedCategories | join ", " }}, live or chezmoi-source). Excludes skills/rules
# (symlink-shared) and .claude.json (never chezmoi-managed, see header). Empty if out of
# scope. Anchored to $HOME/the chezmoi source dir, not a bare ".claude"/"dot_claude" match
# anywhere, so an unrelated project's own .claude/ dir is never mistaken for a profile dir.
path_profile() {
    local p="$1"
    if [[ "$p" =~ ^"$HOME"/\.claude[A-Za-z0-9_-]*/(skills|rules)(/|$) ]] ||
        [[ "$p" =~ ^"{{ $sourceDir }}"/dot_claude[A-Za-z0-9_-]*/(skills|rules)(/|$) ]]; then
        return
    fi
    if [[ "$p" =~ ^"$HOME"/\.claude-([A-Za-z0-9_-]+)/ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$p" =~ ^"$HOME"/\.claude/ ]]; then
        echo "default"
    elif [[ "$p" =~ ^"{{ $sourceDir }}"/dot_claude-([A-Za-z0-9_-]+)/ ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$p" =~ ^"{{ $sourceDir }}"/dot_claude/ ]]; then
        echo "default"
    fi
}

{{ includeTemplate "claude-tooling-guard-shared" . }}
profile_mismatch_message() {
    local active="$1" target="$2"
    if [[ -n "$active" && -n "$target" && "$active" != "$target" ]]; then
        echo " Active profile is ${active} (\$CLAUDE_CONFIG_DIR); this path belongs to ${target}."
    fi
}

# Only decision this hook makes: the mismatch message if $file_path belongs to a different
# profile than the active one, else nothing. Always returns 0 (never trips `set -e`).
check_mismatch() {
    local file_path="$1" tool="$2"
    claude_path_in_scope "$file_path" || return 0

    local resolved_path
    resolved_path=$(resolve_check_path "$file_path")

    local active target mismatch
    active=$(active_profile)
    target=$(path_profile "$resolved_path")
    mismatch=$(profile_mismatch_message "$active" "$target")
    [[ -z "$mismatch" ]] && return 0

    if [[ "$tool" == "Read" ]]; then
        echo "This reads a ${target} profile's file.${mismatch}"
    else
        echo "This touches a ${target} profile's file.${mismatch}"
    fi
    return 0
}

{{ includeTemplate "claude-bash-mutation-target-extraction" . }}
case "$tool_name" in
    Edit | Write | Read)
        file_path=$(jq -r '.tool_input.file_path // ""' <<<"$payload")
        [[ -z "$file_path" ]] && exit 0
        reason=$(check_mismatch "$file_path" "$tool_name")
        [[ -z "$reason" ]] && exit 0
        emit_ask "$reason"
        ;;
    Bash)
        command=$(jq -r '.tool_input.command // ""' <<<"$payload")
        [[ -z "$command" ]] && exit 0

        claude_scope_prefilter "$command" || exit 0
        expanded="$__claude_scope_expanded"

        # Only one decision type here (ask), so the first mismatch found wins outright.
        ask_reason="" target=""
        while IFS= read -r target; do
            [[ -z "$target" ]] && continue
            target="${target/#\~/$HOME}"
            ask_reason=$(check_mismatch "$target" "Write")
            [[ -n "$ask_reason" ]] && break
        done < <(extract_bash_targets "$expanded")

        [[ -n "$ask_reason" ]] && emit_ask "$ask_reason"
        ;;
esac
