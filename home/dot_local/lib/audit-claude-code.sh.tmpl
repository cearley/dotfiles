#!/bin/bash
# audit-claude-code.sh — Claude Code orphan-detection logic (plugins, marketplaces, skills,
# MCP servers) shared by audit-packages and clean-claude-orphans.
#
# Rendered by chezmoi from {{ .chezmoi.sourceDir }}/dot_local/lib/audit-claude-code.sh.tmpl to
# ~/.local/lib/audit-claude-code.sh — edit the source template, then `chezmoi apply` before a
# caller will see the change (same as every other dot_local/ deployment in this repo).
#
# This file is `source`d directly by two chezmoi-templated callers:
#   - home/dot_local/bin/executable_audit-packages.tmpl
#   - home/dot_claude/skills/clean-claude-orphans/scripts/executable_list-claude-orphans.sh.tmpl
# Both just `source "$HOME/.local/lib/audit-claude-code.sh"` with no setup beforehand — this
# file computes its own PACKAGES_YAML/CHEZMOI_MANAGED_SKILLS_DIR at render time below, rather
# than requiring each caller to pass them in as plain shell variables.
#
# Deliberately does NOT source scripts/shared-utils.sh: that library is print_message /
# command_exists human-facing output, and this file is JSONL-only, no human-facing output at
# all. Preconditions (is `claude` on PATH, etc.) are the caller's job, not this file's.

PACKAGES_YAML="{{ .chezmoi.sourceDir }}/.chezmoidata/packages.yaml"
CHEZMOI_MANAGED_SKILLS_DIR="{{ .chezmoi.sourceDir }}/dot_claude/skills"

# Current persona's config dir, respecting $CLAUDE_CONFIG_DIR rather than hardcoding
# ~/.claude, so these functions report correctly under a non-default persona.
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CLAUDE_HOME/settings.json"

{{- $settings := includeTemplate "machine-settings" . | fromJson }}
{{- $claudeEnvs := default (list) (index $settings "claude_envs") }}
{{- $localMarketplaceName := includeTemplate "local-marketplace-name" . }}
# Declared personas only (this machine's claude_envs config) — not a `.claude*` glob. A
# glob was the original audit-packages.tmpl's choice specifically to avoid a chezmoi-data
# dependency ("without needing chezmoi data", per its own old comment); this library
# already pays that cost for PACKAGES_YAML/CHEZMOI_MANAGED_SKILLS_DIR above, so there's no
# reason left to prefer a glob that could also misreport a non-persona dir sharing the
# prefix (.claude-code-session, .claude-monitor, .claude-worktrees, ...) as an environment,
# the same false-positive this repo already fixed once elsewhere.
#
# Public (no leading underscore): list-claude-orphans.sh's own ## environments section
# consumes this array directly instead of re-deriving it from claude_envs itself.
CLAUDE_PERSONA_DIRS=("$HOME/.claude"{{ range $claudeEnvs }} "$HOME/.claude-{{ trimPrefix "~/.claude-" . }}"{{ end }})

# Every settings.json this machine might have: one per declared persona, plus $SETTINGS
# explicitly in case $CLAUDE_CONFIG_DIR points somewhere outside that declared list — the
# same "current persona not in the declared set" case list-claude-orphans.sh's own
# environments section guards against separately. A duplicate between $SETTINGS and a
# persona-dir entry (the common case) is harmless — both call sites already tolerate it.
CLAUDE_ALL_SETTINGS=("$SETTINGS")
for _claude_persona_dir in "${CLAUDE_PERSONA_DIRS[@]}"; do
    CLAUDE_ALL_SETTINGS+=("$_claude_persona_dir/settings.json")
done

# Single source of truth for the {{ $localMarketplaceName }} marketplace suffix test,
# referenced identically by claude_orphan_plugins_jsonl and claude_installed_plugins_jsonl.
CHEZMOI_PERSONAL_SUFFIX="@{{ $localMarketplaceName }}"

# ---------------------------------------------------------------------------
# Shared tail for the three orphan functions whose installed/declared sides are plain
# sorted files (plugins, marketplaces, MCP servers — skills builds its JSONL differently,
# since it also needs per-item skill_tag classification, not just a flat diff): diff them
# and emit one JSONL line per orphan.
# ---------------------------------------------------------------------------
_claude_emit_orphans_jsonl() {
    local category="$1" installed_file="$2" declared_file="$3"
    comm -23 "$installed_file" "$declared_file" 2>/dev/null | while IFS= read -r item; do
        [[ -z "$item" ]] && continue
        jq -cn --arg category "$category" --arg item "$item" '{category: $category, item: $item, skill_tag: null}'
    done || true
}

# ---------------------------------------------------------------------------
# Collect the declared set for a given key under a specific coding agent.
# Moved verbatim from audit-packages.tmpl.
# ---------------------------------------------------------------------------
declared_for_agent() {
    local agent="$1" key="$2"
    yq ".packages.darwin.ai.agents.${agent}.${key}[]?" "$PACKAGES_YAML" 2>/dev/null | sort -u
}

# ---------------------------------------------------------------------------
# List basenames of every directory under $CHEZMOI_MANAGED_SKILLS_DIR, one per line.
# Emits nothing (not an error) if the directory doesn't exist.
# ---------------------------------------------------------------------------
claude_chezmoi_managed_skill_names() {
    [[ -d "$CHEZMOI_MANAGED_SKILLS_DIR" ]] || return 0

    local dir name
    for dir in "$CHEZMOI_MANAGED_SKILLS_DIR"/*/; do
        [[ -e "$dir" ]] || continue
        name=$(basename "$dir")
        echo "$name"
    done
}

# ---------------------------------------------------------------------------
# Emit one compact JSON line per plugin declared in this repo's own
# {{ $localMarketplaceName }} marketplace: {"name":"<plugin-name>","skills":[...]}.
# Fixed path under $HOME, independent of sourceDir (the deployed copy, not the
# chezmoi source, which still has unrendered template syntax jq can't parse).
# ---------------------------------------------------------------------------
claude_chezmoi_personal_plugins_jsonl() {
    local marketplace_json="$HOME/.local/share/claude-plugins/.claude-plugin/marketplace.json"

    if [[ ! -f "$marketplace_json" ]]; then
        echo "error: marketplace.json not found at ${marketplace_json}" >&2
        return 0
    fi

    jq -c '.plugins[] | {name, skills: ((.skills // []) | map(sub("^\\./"; "")))}' "$marketplace_json" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Shared installed-side detection for the two Claude CLI subcommands
# (`plugins list`, `plugins marketplace list`) that each have a modern --json
# form and an older human-readable form: try $json_fn first (its own exit
# status, under this file's inherited `set -o pipefail`, already reflects a
# failure anywhere in its internal pipeline — missing --json support on an
# older CLI, or a jq parse error), falling back to $text_fn's text-parsing
# pipeline only if that fails. Shared by claude_orphan_plugins_jsonl and
# claude_orphan_marketplaces_jsonl so a change to this control flow doesn't
# need to be kept in sync by hand between the two.
# ---------------------------------------------------------------------------
_claude_installed_via_json_or_text() {
    local out_file="$1" json_fn="$2" text_fn="$3"
    if "$json_fn" > "$out_file" 2>/dev/null; then
        :
    else
        "$text_fn" > "$out_file" 2>/dev/null || true
    fi
}

# Installed: .id field from JSON. sort -u, not sort: the same id can
# legitimately appear once per scope it's installed/enabled in.
_claude_plugins_installed_json() {
    claude plugins list --json 2>/dev/null | jq -r '.[].id' 2>/dev/null | sort -u
}

# Fallback: parse text output for id@marketplace-shaped tokens.
_claude_plugins_installed_text() {
    claude plugins list 2>/dev/null | grep -oE '[a-zA-Z0-9_-]+@[a-zA-Z0-9_-]+' | sort -u
}

_claude_marketplaces_installed_json() {
    # A git-sourced marketplace's `.url` is the raw clone URL (often with a trailing
    # `.git`), but packages.yaml declares the same marketplace without it — strip it so
    # the two sides can actually match. No-op for `github`/`directory` sources, whose
    # `.repo`/`.path` never carry a `.git` suffix.
    claude plugins marketplace list --json 2>/dev/null \
        | jq -r '.[] | if .source == "github" then .repo elif .source == "directory" then .path else .url end' 2>/dev/null \
        | sed 's/\.git$//' \
        | sort
}

_claude_marketplaces_installed_text() {
    claude plugins marketplace list 2>/dev/null | grep -E '^\s+❯' | awk '{print $2}' | sort
}

# ---------------------------------------------------------------------------
# Diff installed Claude Code plugin ids against declared ids. Declared side is
# the union of declared_for_agent "claude_code" "plugins" and every installed
# id ending in the literal @{{ $localMarketplaceName }} suffix (a direct id-suffix test, via the
# same jq endswith() check claude_installed_plugins_jsonl uses — NOT a lookup
# against claude_chezmoi_personal_plugins_jsonl's marketplace names; those are
# two different checks).
# ---------------------------------------------------------------------------
claude_orphan_plugins_jsonl() {
    local installed_file declared_file
    installed_file=$(mktemp)
    declared_file=$(mktemp)

    _claude_installed_via_json_or_text "$installed_file" _claude_plugins_installed_json _claude_plugins_installed_text

    {
        declared_for_agent "claude_code" "plugins"
        jq -Rr --arg suffix "$CHEZMOI_PERSONAL_SUFFIX" 'select(endswith($suffix))' "$installed_file" 2>/dev/null || true
    } | sort -u > "$declared_file"

    _claude_emit_orphans_jsonl "plugin" "$installed_file" "$declared_file"

    rm -f "$installed_file" "$declared_file"
}

# ---------------------------------------------------------------------------
# Diff installed Claude Code plugin marketplaces against declared marketplaces.
# Ports audit_claude_marketplaces' exact installed-side and declared-side logic.
# ---------------------------------------------------------------------------
claude_orphan_marketplaces_jsonl() {
    local installed_file declared_file
    installed_file=$(mktemp)
    declared_file=$(mktemp)

    _claude_installed_via_json_or_text "$installed_file" _claude_marketplaces_installed_json _claude_marketplaces_installed_text

    declared_for_agent "claude_code" "plugin_marketplaces" \
        | sed 's/#[^#]*$//' \
        | sed "s|\$HOME|$HOME|" \
        | sed 's/\.git$//' \
        | sort > "$declared_file"

    _claude_emit_orphans_jsonl "marketplace" "$installed_file" "$declared_file"

    rm -f "$installed_file" "$declared_file"
}

# ---------------------------------------------------------------------------
# Returns 0 if the user-scope skills directory exists, 1 otherwise. No output.
# ---------------------------------------------------------------------------
claude_skills_dir_present() {
    [[ -d "$CLAUDE_HOME/skills" ]]
}

# ---------------------------------------------------------------------------
# Derive a skill-name prefix from a collection-wildcard spec: the org
# component (before /) with known company suffixes and trailing separators
# stripped. e.g. "specstoryai/agent-skills -all" -> "specstory". Ported
# verbatim from audit-packages.tmpl's _wildcard_prefix.
# ---------------------------------------------------------------------------
_claude_wildcard_prefix() {
    local spec="$1"
    local org
    org=$(echo "$spec" | cut -d'/' -f1)
    echo "$org" \
        | sed -E 's/(ai|hq|io|dev|co|labs|inc|app|apps|tech|ware|js|ly)$//' \
        | sed -E 's/[-_]+$//'
}

# ---------------------------------------------------------------------------
# True if skill_name's name starts with the org-derived prefix of any wildcard spec in
# the newline-delimited $wildcards. Called by _claude_classify_skill, which both
# claude_orphan_skills_jsonl and claude_skills_wildcard_coverage_note share.
# ---------------------------------------------------------------------------
_claude_skill_attributed_to_wildcard() {
    local skill_name="$1" wildcards="$2"
    local wc_spec prefix
    while IFS= read -r wc_spec; do
        [[ -z "$wc_spec" ]] && continue
        prefix=$(_claude_wildcard_prefix "$wc_spec")
        [[ -n "$prefix" && "$skill_name" == "${prefix}"* ]] && return 0
    done <<< "$wildcards"
    return 1
}

# ---------------------------------------------------------------------------
# Split declared "claude_code" "skills" specs into known-skill names
# (deterministic path-style and --skill-flag specs) and wildcard collection
# specs. Writes newline-delimited results into the caller's _known_out and
# _wildcards_out variable names (nameref-free portable approach: caller reads
# $__known_skills / $__wildcards after calling).
# ---------------------------------------------------------------------------
_claude_split_skill_specs() {
    local declared_specs
    declared_specs=$(declared_for_agent "claude_code" "skills")

    __known_skills=""
    __wildcards=""

    while IFS= read -r spec; do
        [[ -z "$spec" ]] && continue
        local matched=false

        # Path-style: */skills/<name>
        if [[ "$spec" =~ ^[^[:space:]]*/skills/([^[:space:]/]+) ]]; then
            __known_skills="${__known_skills}${BASH_REMATCH[1]}"$'\n'
            matched=true
        fi

        # --skill <name...> flag: variadic, one or more names before next -flag/end.
        local -a spec_toks
        read -ra spec_toks <<< "$spec"
        local ti=0
        while [[ $ti -lt ${#spec_toks[@]} ]]; do
            if [[ "${spec_toks[$ti]}" == "--skill" ]]; then
                matched=true
                ti=$((ti + 1))
                while [[ $ti -lt ${#spec_toks[@]} && "${spec_toks[$ti]}" != -* ]]; do
                    __known_skills="${__known_skills}${spec_toks[$ti]}"$'\n'
                    ti=$((ti + 1))
                done
            else
                ti=$((ti + 1))
            fi
        done

        if [[ "$matched" == false ]]; then
            __wildcards="${__wildcards}${spec}"$'\n'
        fi
    done <<< "$declared_specs"
}

# ---------------------------------------------------------------------------
# Classify a single skill directory name against the known/managed/wildcard
# sources, in precedence order: "known" (matched by a deterministic spec),
# "managed" (a chezmoi-managed native skill), "wildcard" (covered by a
# collection spec), or "orphan" (none of the above). Shared by
# claude_orphan_skills_jsonl and claude_skills_wildcard_coverage_note so both
# walk the same classification instead of each re-deriving it — in particular
# so a chezmoi-managed skill whose name happens to also match a wildcard
# prefix is never counted as "wildcard-covered" by either caller, since it's
# never actually an orphan the wildcard needed to cover.
# ---------------------------------------------------------------------------
_claude_classify_skill() {
    local skill_name="$1" known_skills="$2" managed_skills="$3" wildcards="$4"

    if echo "$known_skills" | grep -qxF "$skill_name"; then
        echo "known"
        return
    fi

    if [[ -n "$managed_skills" ]] && echo "$managed_skills" | grep -qxF "$skill_name"; then
        echo "managed"
        return
    fi

    if _claude_skill_attributed_to_wildcard "$skill_name" "$wildcards"; then
        echo "wildcard"
        return
    fi

    echo "orphan"
}

# ---------------------------------------------------------------------------
# Orphan Claude Code skills: assumes the caller already checked
# claude_skills_dir_present. Ports audit_claude_skills' deterministic-mapping
# and wildcard-prefix-coverage logic exactly, additionally excluding names
# from claude_chezmoi_managed_skill_names, and tagging bundled-by-plugin
# duplicates via a jq lookup against claude_chezmoi_personal_plugins_jsonl.
# ---------------------------------------------------------------------------
claude_orphan_skills_jsonl() {
    local skills_dir="$CLAUDE_HOME/skills"

    local __known_skills __wildcards
    _claude_split_skill_specs
    local known_skills="$__known_skills"
    local wildcards="$__wildcards"

    local managed_skills
    managed_skills=$(claude_chezmoi_managed_skill_names)

    local orphans=""

    local skill_dir
    for skill_dir in "$skills_dir"/*/; do
        [[ -e "$skill_dir" ]] || continue
        local skill_name
        skill_name=$(basename "$skill_dir")

        local classification
        classification=$(_claude_classify_skill "$skill_name" "$known_skills" "$managed_skills" "$wildcards")
        [[ "$classification" == "orphan" ]] || continue

        local bundled_by
        bundled_by=$(claude_chezmoi_personal_plugins_jsonl 2>/dev/null \
            | jq -r --arg skill "$skill_name" 'select(.skills | index($skill)) | .name' 2>/dev/null \
            | head -n1)

        if [[ -n "$bundled_by" ]]; then
            orphans="${orphans}$(jq -cn --arg item "$skill_name" --arg tag "bundled-by:${bundled_by}" '{category: "skill", item: $item, skill_tag: $tag}')"$'\n'
        else
            orphans="${orphans}$(jq -cn --arg item "$skill_name" '{category: "skill", item: $item, skill_tag: null}')"$'\n'
        fi
    done

    printf '%s' "$orphans" | grep -v '^$' | sort || true
}

# ---------------------------------------------------------------------------
# Returns the "Skills not individually verified (covered by collection spec):
# ..." note text when at least one wildcard spec covered an installed skill,
# or nothing otherwise. Kept separate from claude_orphan_skills_jsonl's JSONL
# stream — no field is added to that stream for this.
# ---------------------------------------------------------------------------
claude_skills_wildcard_coverage_note() {
    local skills_dir="$CLAUDE_HOME/skills"

    local __known_skills __wildcards
    _claude_split_skill_specs
    local known_skills="$__known_skills"
    local wildcards="$__wildcards"

    local managed_skills
    managed_skills=$(claude_chezmoi_managed_skill_names)

    local wildcard_covered=false

    local skill_dir
    for skill_dir in "$skills_dir"/*/; do
        [[ -e "$skill_dir" ]] || continue
        local skill_name
        skill_name=$(basename "$skill_dir")

        local classification
        classification=$(_claude_classify_skill "$skill_name" "$known_skills" "$managed_skills" "$wildcards")
        [[ "$classification" == "wildcard" ]] && wildcard_covered=true
    done

    if [[ "$wildcard_covered" == true ]]; then
        local wc_note
        wc_note=$(printf '%s' "$wildcards" | tr '\n' ',' | sed 's/,*$//' | sed 's/,/, /g')
        echo "Skills not individually verified (covered by collection spec): ${wc_note}"
    fi
}

# ---------------------------------------------------------------------------
# Returns 0 if any file in $CLAUDE_ALL_SETTINGS exists, 1 otherwise. No output.
# ---------------------------------------------------------------------------
claude_mcp_settings_present() {
    local settings_file
    for settings_file in "${CLAUDE_ALL_SETTINGS[@]}"; do
        [[ -f "$settings_file" ]] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# Orphan Claude Code MCP servers: assumes the caller already checked
# claude_mcp_settings_present. Declared side MUST be a direct .name-extracting
# yq query — mcp_servers entries are structured maps ({name, scope, command}),
# not plain strings, so declared_for_agent's generic .key[]? query would
# return whole map objects here and never string-match an installed server
# name, making every declared MCP server show as a false orphan.
# ---------------------------------------------------------------------------
claude_orphan_mcp_servers_jsonl() {
    local installed_file declared_file
    installed_file=$(mktemp)
    declared_file=$(mktemp)

    local settings_file
    for settings_file in "${CLAUDE_ALL_SETTINGS[@]}"; do
        [[ -f "$settings_file" ]] || continue
        jq -r '.mcpServers // {} | keys[]' "$settings_file" 2>/dev/null >> "$installed_file" || true
    done

    sort -u "$installed_file" -o "$installed_file"

    yq ".packages.darwin.ai.agents.claude_code.mcp_servers[]?.name" "$PACKAGES_YAML" 2>/dev/null \
        | sort -u > "$declared_file"

    _claude_emit_orphans_jsonl "mcp_server" "$installed_file" "$declared_file"

    rm -f "$installed_file" "$declared_file"
}

# ---------------------------------------------------------------------------
# `claude plugins list --json`'s `enabled`/`projectEnabled` fields for a
# project/local-scope entry reflect the cwd this command itself was run from,
# not necessarily the plugin's own projectPath — observed live: entries that
# looked disabled when this library ran from an unrelated directory (e.g. the
# chezmoi repo) came back enabled once the same command ran with cwd inside
# their actual project. Re-run the listing once per distinct project/local
# projectPath, with cwd there, and patch in that path's corrected
# enabled/projectEnabled values. User-scope entries aren't cwd-dependent and
# are left untouched. Mutates and echoes the caller's plugins_json variable
# by nameref so claude_installed_plugins_jsonl can just call this once.
# ---------------------------------------------------------------------------
_claude_fix_project_scope_enabled() {
    local plugins_json="$1"

    local project_paths
    project_paths=$(echo "$plugins_json" \
        | jq -r '.[] | select(.scope == "project" or .scope == "local") | .projectPath // empty' \
        | sort -u)

    local path corrected
    while IFS= read -r path; do
        [[ -n "$path" && -d "$path" ]] || continue
        corrected="$(cd "$path" && claude plugins list --json 2>/dev/null)" || continue
        [[ -n "$corrected" ]] || continue

        plugins_json=$(jq -c --argjson corrected "$corrected" --arg path "$path" '
            ($corrected
                | map(select(.projectPath == $path))
                | map({key: (.id + "|" + .scope), value: {enabled, projectEnabled}})
                | from_entries) as $fix
            | map(
                if .projectPath == $path and ($fix[.id + "|" + .scope] != null)
                then . + $fix[.id + "|" + .scope]
                else .
                end
              )
        ' <<< "$plugins_json" 2>/dev/null) || continue
    done <<< "$project_paths"

    printf '%s' "$plugins_json"
}

# ---------------------------------------------------------------------------
# One JSONL line per currently installed plugin: id, scope, projectPath,
# chezmoi_personal (same @{{ $localMarketplaceName }} suffix test as
# claude_orphan_plugins_jsonl, via $CHEZMOI_PERSONAL_SUFFIX), enabled.
# ---------------------------------------------------------------------------
claude_installed_plugins_jsonl() {
    local plugins_json
    plugins_json="$(claude plugins list --json 2>/dev/null)" || true
    [[ -n "$plugins_json" ]] || return 0

    plugins_json="$(_claude_fix_project_scope_enabled "$plugins_json")"

    echo "$plugins_json" | jq -c --arg suffix "$CHEZMOI_PERSONAL_SUFFIX" '.[] | {
        id,
        scope,
        projectPath: (.projectPath // null),
        chezmoi_personal: (.id | endswith($suffix)),
        enabled
    }' 2>/dev/null || true
}
