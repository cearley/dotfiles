{{- /* Shared helpers for the two sibling PreToolUse guards that both reason about
     Claude Code tooling paths: executable_claude-tooling-write-guard.tmpl (managed-file
     protection) and executable_claude-profile-mismatch-guard.tmpl (cross-profile
     detection). Each includes this once, then calls:
       - resolve_check_path    (unchanged by either caller)
       - claude_path_in_scope  (replaces each caller's own duplicated scope `case`)
       - claude_scope_prefilter (replaces each caller's own duplicated Bash-command
         $CLAUDE_CONFIG_DIR/$HOME expansion + broad_pattern fast filter; sets
         $__claude_scope_expanded as its side effect on success)
     Uses {{ .chezmoi.sourceDir }} directly, so callers must `includeTemplate` this with
     their own `.` context (same convention as claude-bash-mutation-target-extraction). */ -}}

# Falls back to a realpath'd dirname + basename if the path doesn't exist yet (a Write
# target that hasn't been created).
resolve_check_path() {
    local file_path="$1"
    local resolved_path="$file_path" real real_parent
    if real=$(realpath "$file_path" 2>/dev/null); then
        resolved_path="$real"
    elif real_parent=$(realpath "$(dirname "$file_path")" 2>/dev/null); then
        resolved_path="${real_parent}/$(basename "$file_path")"
    fi
    echo "$resolved_path"
}

# Whether $1 is in scope for either guard at all -- under $HOME/.claude*/ (live/deployed)
# or this repo's chezmoi source dot_claude*/ (unapplied edits). Anything else returns 1
# immediately so callers bail before doing any further resolution work.
claude_path_in_scope() {
    case "$1" in
        "$HOME"/.claude*/*) return 0 ;;
        "{{ .chezmoi.sourceDir }}"/dot_claude*/*) return 0 ;;
        *) return 1 ;;
    esac
}

# Expands $CLAUDE_CONFIG_DIR/$HOME in a raw Bash command string (it isn't shell-evaluated,
# so a literal "$HOME" would otherwise never match a filesystem path) and reports whether
# the result could touch Claude Code tooling at all -- a fast pre-filter before walking
# extract_bash_targets. On success, sets $__claude_scope_expanded to the expanded string;
# on failure (out of scope), leaves it unset and returns 1.
claude_scope_prefilter() {
    local command="$1"
    local config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    local expanded="$command"
    expanded="${expanded//\$\{CLAUDE_CONFIG_DIR\}/$config_dir}"
    expanded="${expanded//\$CLAUDE_CONFIG_DIR/$config_dir}"
    expanded="${expanded//\$\{HOME\}/$HOME}"
    expanded="${expanded//\$HOME/$HOME}"

    local broad_pattern='(\.claude[A-Za-z0-9_-]*/(settings\.json|plugins/|skills/|rules/)|\.claude\.json|dot_claude[A-Za-z0-9_-]*/)'
    [[ "$expanded" =~ $broad_pattern ]] || return 1
    __claude_scope_expanded="$expanded"
}
