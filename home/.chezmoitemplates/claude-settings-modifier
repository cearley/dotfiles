{{- /* Writes the settings a persona wants chezmoi-managed into its settings.json.

     WHERE TO EDIT: each persona's managed settings are the .claude-settings.json next to
     its modify_settings.json.tmpl, in settings.json's own shape (copy blocks to and from
     a live settings.json as-is):

       home/dot_claude/.claude-settings.json          ~/.claude/settings.json
       home/dot_claude-personal/.claude-settings.json ~/.claude-personal/settings.json
       home/dot_claude-work/.claude-settings.json     ~/.claude-work/settings.json
       home/dot_claude-bedrock/.claude-settings.json  ~/.claude-bedrock/settings.json

     chezmoi ignores source paths starting with ".", so these files are neither deployed
     nor parsed as templates ("{{" is safe in them). Every modify_settings.json.tmpl is the
     same one line, `includeTemplate "claude-settings-modifier" .`; this partial finds the
     sibling file from .chezmoi.sourceFile, so a new persona is a copied directory.

     WHAT chezmoi apply DOES:
       - Objects merge key by key. Keys Claude Code, plugins, or you add at runtime are kept.
       - Arrays gain the elements listed in source, keeping their live order; elements added
         at runtime survive in place. A hook group is one element, compared by full value.
       - Scalars in source overwrite the live value. A runtime change to a managed scalar
         (e.g. /config changing permissions.defaultMode) is reverted. check-claude-overrides
         flags these at session start; `check-claude-overrides --fix <persona> <kind> <key>`
         keeps such a change by writing it into the source file.
       - Removing something from source removes it from the live file on the next apply:
         array elements always, a scalar only while its live value is still what chezmoi
         wrote. Containers emptied this way are kept.
     The last-applied source is saved in settings.json as the string _chezmoiManaged (a
     string, so Claude Code never sees hook-shaped objects outside "hooks"); don't edit it.
     With no saved copy (first run, or the pre-2026-09-26 array ledger) nothing is retracted.

     DON'TS:
       - Don't `chezmoi add` or `chezmoi re-add` a persona settings.json: add replaces the
         merge script with a full snapshot of the live file (the write guard denies it).
       - Don't put settings in modify_settings.json.tmpl.

     Params: claudeSettings (optional) — JSON text used instead of the sibling file; tests
     pass it. Tests: tests/test-claude-settings-ledger.sh. Spec:
     openspec/specs/claude-settings-ledger/.
*/ -}}
{{- if not (and (eq .chezmoi.os "darwin") (has "ai" .tags)) -}}
#!/bin/bash
# Not a darwin+ai machine — pass through unchanged
cat
{{- else -}}
#!/bin/bash
# Apply chezmoi-managed settings; preserve everything else Claude Code manages.
set -euo pipefail

existing=$(cat)
[ -z "$existing" ] && existing='{}'

{{- $json := get . "claudeSettings" }}
{{- if not $json }}{{ $json = include (joinPath (dir .chezmoi.sourceFile) ".claude-settings.json") }}{{ end }}
{{- $managed := $json | fromJson }}
{{- if not (kindIs "map" $managed) }}{{ fail "claude-settings-modifier: claudeSettings must be a JSON object" }}{{ end }}
managed='{{ $managed | toJson | replace "'" "\\u0027" }}'

echo "$existing" | jq --argjson managed "$managed" '
  # Merge $m into the input: objects by key, arrays as an order-preserving union.
  def apply($m):
    if ($m | type) == "object" then
      reduce ($m | keys_unsorted[]) as $k (if type == "object" then . else {} end;
        .[$k] |= apply($m[$k]))
    elif ($m | type) == "array" then
      reduce $m[] as $e (if type == "array" then . else [] end;
        if any(.[]; . == $e) then . else . + [$e] end)
    else $m end;

  # Remove what $old declared that $new does not; scalars only if still unchanged.
  def retract($old; $new):
    if type == "object" and ($old | type) == "object" then
      reduce ($old | to_entries[]) as {key: $k, value: $v} (.;
        ($new | type == "object" and has($k)) as $kept
        | if has($k) | not then .
          elif ($v | type) == "object" or ($v | type) == "array" then
            .[$k] |= retract($v; if $kept then $new[$k] else null end)
          elif $kept or .[$k] != $v then .
          else del(.[$k]) end)
    elif type == "array" and ($old | type) == "array" then
      ($new | if type == "array" then . else [] end) as $keep
      | map(select(. as $e | any($keep[]; . == $e) or all($old[]; . != $e)))
    else . end;

  (if type == "object" then . else {} end)
  | (._chezmoiManaged | if type == "string" then (try fromjson catch {}) else {} end) as $prev
  | del(._chezmoiManaged)
  | retract($prev; $managed)
  | apply($managed)
  | if $managed == {} then . else ._chezmoiManaged = ($managed | tojson) end
'
{{- end }}
