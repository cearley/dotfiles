{{- /* Writes the settings a persona wants chezmoi-managed into its settings.json.

     Params (merge with the chezmoi context before calling):
       claudeSettings: JSON text, in the same shape as settings.json, holding everything
                       chezmoi manages for this persona. Callers pass
                       (include ".claude-settings/<persona>.json"). chezmoi neither
                       deploys nor template-parses dot-prefixed source paths.

     Apply: objects merge key by key, arrays gain the managed elements they lack (live
     order kept, so entries added outside chezmoi survive in place), and everything else
     is overwritten. A hook group is one array element, compared by full value.

     Removal: the managed JSON is saved in settings.json as the string _chezmoiManaged
     (a string, so Claude Code never sees hook-shaped objects outside "hooks"). The next
     run retracts whatever that saved copy declares and the current source no longer does:
     array elements always, scalars only while the live value is unchanged. Containers
     retraction empties are kept. With no saved copy (first run, or the pre-2026-09-26
     array ledger) nothing is retracted.

     Tests: tests/test-claude-settings-ledger.sh.

     Example:
       {{ includeTemplate "claude-settings-modifier" (merge (dict "claudeSettings" (include ".claude-settings/personal.json")) .) }}
*/ -}}
{{- if not (and (eq .chezmoi.os "darwin") (has "ai" .tags)) -}}
#!/bin/bash
# Not a darwin+ai machine — pass through unchanged
cat
{{- else -}}
#!/bin/bash
# Apply chezmoi-managed settings; preserve everything else Claude Code manages.
set -euo pipefail

existing=$(cat)
[ -z "$existing" ] && existing='{}'

{{- $managed := get . "claudeSettings" | default "{}" | fromJson }}
{{- if not (kindIs "map" $managed) }}{{ fail "claude-settings-modifier: claudeSettings must be a JSON object" }}{{ end }}
managed='{{ $managed | toJson | replace "'" "\\u0027" }}'

echo "$existing" | jq --argjson managed "$managed" '
  # Merge $m into the input: objects by key, arrays as an order-preserving union.
  def apply($m):
    if ($m | type) == "object" then
      reduce ($m | keys_unsorted[]) as $k (if type == "object" then . else {} end;
        .[$k] |= apply($m[$k]))
    elif ($m | type) == "array" then
      reduce $m[] as $e (if type == "array" then . else [] end;
        if any(.[]; . == $e) then . else . + [$e] end)
    else $m end;

  # Remove what $old declared that $new does not; scalars only if still unchanged.
  def retract($old; $new):
    if type == "object" and ($old | type) == "object" then
      reduce ($old | to_entries[]) as {key: $k, value: $v} (.;
        ($new | type == "object" and has($k)) as $kept
        | if has($k) | not then .
          elif ($v | type) == "object" or ($v | type) == "array" then
            .[$k] |= retract($v; if $kept then $new[$k] else null end)
          elif $kept or .[$k] != $v then .
          else del(.[$k]) end)
    elif type == "array" and ($old | type) == "array" then
      ($new | if type == "array" then . else [] end) as $keep
      | map(select(. as $e | any($keep[]; . == $e) or all($old[]; . != $e)))
    else . end;

  (if type == "object" then . else {} end)
  | (._chezmoiManaged | if type == "string" then (try fromjson catch {}) else {} end) as $prev
  | del(._chezmoiManaged)
  | retract($prev; $managed)
  | apply($managed)
  | if $managed == {} then . else ._chezmoiManaged = ($managed | tojson) end
'
{{- end }}
