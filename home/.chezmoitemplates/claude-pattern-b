{{- /* claude-pattern-b — Pattern B: curated allow-list permission posture.

     Renders a `permissions`-only JSON block: `defaultMode: "default"` (still prompts for
     anything not listed below) plus an `allow` list of specific, individually-reasoned
     safe operations — read-only inspection, version control history/status (never push/
     reset/clean), and common test/lint/build runners. This is a deliberately small, curated
     starting point, not a copy of any repo's own hand-accumulated allow-list — see
     proposal.md's Why for the ~200-entry accretion this pattern exists to replace.

     Consumed only by the `apply-claude-pattern` stamping tool
     (home/dot_local/bin/executable_apply-claude-pattern.tmpl), which writes this block into
     the CURRENT project repo's gitignored .claude/settings.local.json — never a persona
     settings.json (~/.claude, ~/.claude-work, etc.), and never part of the
     claude-settings-ledger/claude-settings-modifier persona-settings mechanism. Not included
     via `includeTemplate`
     by any modify_ script.

     Use for: personal/exploratory repos, where routine read-only and test/lint/build
     commands shouldn't each need a separate prompt, but anything else still should.

     Test: `chezmoi execute-template < home/.chezmoitemplates/claude-pattern-b | jq .`
     Spec: openspec/specs/claude-repo-permission-patterns/
*/ -}}
{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm ci)",
      "Bash(pnpm install)",
      "Bash(uv sync)",
      "Bash(uv run *)",
      "Bash(ruff check)",
      "Bash(ruff format)",
      "Bash(pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Write(src/**)",
      "Write(tests/**)",
      "mcp__github-readonly__list_issues",
      "mcp__github-readonly__get_issue",
      "mcp__github-readonly__list_pull_requests",
      "mcp__fs-docs__read_file"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(uv add *)",
      "Write(.github/**)",
      "Write(infrastructure/**)",
      "mcp__github-readonly__create_comment"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(* | sh)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Write(./.git/**)",
      "Write(./.env*)",
      "WebFetch"
    ]
  },
  "cleanupPeriodDays": 30
}
