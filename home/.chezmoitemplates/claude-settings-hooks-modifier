{{- /* Merges session-topic-capture hooks, the claude-tooling-guard PreToolUse hook, and any
     per-environment extra top-level settings the caller wants chezmoi-managed.

     Params (merge with the chezmoi context before calling):
       claudeExtraSettings: optional dict, default {}. Recursively merged over
                    the existing settings.json (jq `*`) after the hooks merge —
                    e.g. skillOverrides, enabledPlugins, permissions. Only pass
                    this for an environment whose skill/plugin/permission
                    posture has actually been analyzed for that environment;
                    other callers get {} and are unaffected.

     Example:
       {{ includeTemplate "claude-settings-hooks-modifier" (merge (dict "claudeExtraSettings" (dict "permissions" (dict "defaultMode" "auto"))) .) }}
*/ -}}
{{- if not (and (eq .chezmoi.os "darwin") (has "ai" .tags)) -}}
#!/bin/bash
# Not a darwin+ai machine — pass through unchanged
cat
{{- else -}}
#!/bin/bash
# Merge managed hooks and any extra settings; preserve everything else managed by Claude Code.
set -euo pipefail

existing=$(cat)
[ -z "$existing" ] && existing='{}'

managed_hooks='{
  "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "session-topic-capture UserPromptSubmit"}]}],
  "PreCompact":       [{"matcher": "", "hooks": [{"type": "command", "command": "session-topic-capture PreCompact"}]}],
  "SessionEnd":       [{"matcher": "", "hooks": [{"type": "command", "command": "session-topic-capture SessionEnd"}]}],
  "PreToolUse":       [{"matcher": "Bash", "hooks": [{"type": "command", "command": "claude-tooling-guard"}]}],
  "SessionStart":     [{"matcher": "", "hooks": [{"type": "command", "command": "check-claude-overrides --session-start"}]}]
}'

extra_settings='{{ get . "claudeExtraSettings" | default (dict) | toJson }}'

echo "$existing" | jq --argjson managed "$managed_hooks" --argjson extra "$extra_settings" '
  reduce ($managed | keys[]) as $event (
    .;
    ((.hooks[$event] // []) | map(.hooks[]?.command)) as $existing_cmds |
    .hooks[$event] = (
      (.hooks[$event] // []) +
      ($managed[$event] | map(
        . as $entry |
        select(($existing_cmds | index($entry.hooks[0].command)) == null)
      ))
    )
  )
  | . * $extra
'
{{- end }}
