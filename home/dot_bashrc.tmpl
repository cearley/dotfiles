{{ if has "dev" .tags -}}
# AWS bash completion
[ -x "$HOMEBREW_PREFIX/bin/aws_completer" ] && complete -C "$HOMEBREW_PREFIX/bin/aws_completer" aws
# AWS cli for use with LocalStack. (See https://github.com/localstack/awscli-local#alternative.)
alias awslocal="AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_DEFAULT_REGION=${DEFAULT_REGION:-$AWS_DEFAULT_REGION} aws --endpoint-url=http://${LOCALSTACK_HOST:-localhost}:4566"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
# Load nvm
export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm
{{- end }}

{{- $settings := includeTemplate "machine-settings" . | fromJson -}}
{{- $claudeDefault := default "" (index $settings "claude_default") }}
{{- if $claudeDefault }}
export CLAUDE_CONFIG_DIR="$HOME/.{{ $claudeDefault }}"
{{- end }}

# ccenv - CLAUDE_CONFIG_DIR profile manager (https://github.com/cearley/zsh-claude-env)
export PATH="{{ .chezmoi.homeDir }}/.oh-my-zsh/custom/plugins/zsh-claude-env/bin:$PATH"
command -v ccenv >/dev/null 2>&1 && eval "$(ccenv init -)"

{{- if has "ai" .tags }}
export CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1
{{- end }}

{{ if has "ai" .tags -}}
alias openspecui='npx openspecui@latest'
# Added by LM Studio CLI (lms)
export PATH="$PATH:{{- .chezmoi.homeDir -}}/.cache/lm-studio/bin"
export PATH="$PATH:{{- .chezmoi.homeDir -}}/.lmstudio/bin"
# End of LM Studio CLI section
{{- end }}

# direnv - Load/unload environment variables based on $PWD
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

# Astral.sh uv - Python package manager
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
command -v uv >/dev/null 2>&1 && eval "$(uv generate-shell-completion bash)"
command -v uvx >/dev/null 2>&1 && eval "$(uvx --generate-shell-completion bash)"
